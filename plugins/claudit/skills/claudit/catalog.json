  "features": [
    {"id": "claude-md", "feature": "CLAUDE.md project instructions", "when": "Claude is corrected twice on the same thing, or must know commands and conventions it can't infer", "detect": "CLAUDE.md, .claude/CLAUDE.md or AGENTS.md exists", "doc": "memory-size", "min_version": null},
    {"id": "allowlist", "feature": "Permission allow rules", "when": "The same safe commands (tests, lint, CI script) prompt every time", "detect": "permissions.allow Bash rules cover the check commands", "doc": "permission-rules", "min_version": null},
    {"id": "secret-deny", "feature": "Permission deny rules for secrets", "when": "The repo has or ignores .env, keys or credentials", "detect": "permissions.deny Read(...) rules cover the secret paths", "doc": "read-edit-rules", "min_version": null},
    {"id": "stop-hook", "feature": "Stop hook that runs the check", "when": "Instructions say to always run a check before finishing", "detect": "A Stop (or SubagentStop/TaskCompleted) hook runs the check", "doc": "stop-hook", "min_version": null},
    {"id": "procedure-skill", "feature": "Project skill for a procedure", "when": "A numbered procedure (release, deploy, review) is followed repeatedly", "detect": ".claude/skills/<name>/SKILL.md covers the procedure", "doc": "procedures-skills", "min_version": null},
    {"id": "scoped-rules", "feature": "Path-scoped rules", "when": "Instructions apply only to one directory or file type", "detect": ".claude/rules/*.md with paths frontmatter", "doc": "scoped-rules", "min_version": null},
    {"id": "plugin-validate", "feature": "claude plugin validate", "when": "The repo ships a plugin or marketplace", "detect": "CI or documented checks run claude plugin validate", "doc": "plugin-validate", "min_version": "2.1.289"},
    {"id": "plugin-eval", "feature": "claude plugin eval suite", "when": "The repo ships a plugin whose skills or agents should be measured", "detect": "An evals/ suite exists and CI or docs run claude plugin eval", "doc": "plugin-evals", "min_version": "2.1.269"},
    {"id": "code-intelligence", "feature": "Code intelligence (LSP) plugin", "when": "Typed codebase where Claude searches for definitions and references", "detect": "An *-lsp plugin is enabled in settings", "doc": "code-intelligence", "min_version": null},
    {"id": "prompt-audit", "feature": "/doctor prompt-audit", "when": "Several or long instruction files that may drift, contradict or dangle", "detect": "Not detectable from files; recommend running it", "doc": "prompt-audit", "min_version": "2.1.283"},
    {"id": "doctor", "feature": "/doctor setup checkup", "when": "Any project: unused skills, MCP servers and plugins against context cost, slow hooks, frequently denied commands", "detect": "Not detectable from files; recommend running it", "doc": "doctor", "min_version": null},
    {"id": "insights", "feature": "/insights usage report", "when": "Recurring friction across sessions", "detect": "Not detectable from files; recommend running it", "doc": "insights", "min_version": null},
    {"id": "skill-doctor", "feature": "/skill-doctor", "when": "Many skills or plugins whose context cost and use are unknown", "detect": "Not detectable from files; recommend running it", "doc": "skill-doctor", "min_version": "2.1.252"},
    {"id": "subagents", "feature": "Project subagents", "when": "Side tasks (research, review) flood the main conversation", "detect": ".claude/agents/*.md", "doc": "subagents", "min_version": null},
    {"id": "sandbox", "feature": "Sandboxed Bash", "when": "Agents run shell commands unattended or broad allow rules are needed", "detect": "sandbox settings enabled", "doc": "sandboxing", "min_version": null},
    {"id": "headless", "feature": "Headless runs with scoped tools", "when": "Agents or CI run Claude non-interactively", "detect": "claude -p in scripts or workflows with --allowedTools", "doc": "headless", "min_version": null},
    {"id": "worktrees", "feature": "Parallel worktrees", "when": "Several agents or tasks work in the repo at once", "detect": "worktree settings or documented worktree use", "doc": "worktrees", "min_version": null},
    {"id": "mcp", "feature": "Project MCP servers", "when": "Work needs data from a tool Claude can't see", "detect": ".mcp.json at the project root", "doc": "mcp-project", "min_version": null},
    {"id": "output-styles", "feature": "Output styles", "when": "Users keep asking for a different answer format", "detect": "outputStyle setting or .claude/output-styles/", "doc": "output-styles", "min_version": null},
    {"id": "github-actions", "feature": "Claude Code GitHub Actions", "when": "Reviews or fixes should run on pull requests", "detect": ".github/workflows using anthropics/claude-code-action", "doc": "github-actions", "min_version": null}
