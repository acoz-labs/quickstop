#!/usr/bin/env bash
# bin/release <version>: compile changes/ into CHANGELOG.md, tag, build the tarball and wheel.
set -euo pipefail
cd "$(dirname "$0")/.."
version="$1"
python -m lanternhall.release_notes "$version" changes CHANGELOG.md
git rm -q changes/[0-9]*.md
git commit -qm "Release $version"
git tag "v$version"
python -m build --sdist --wheel
(cd dist && sha256sum * > SHA256SUMS)
