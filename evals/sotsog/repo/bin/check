#!/usr/bin/env bash
# Run before pushing: tests, lint and the news-fragment check.
set -euo pipefail
cd "$(dirname "$0")/.."
python -m pytest -q
ruff check src tests
base="${CHECK_BASE:-origin/main}"
if git diff --name-only "$base"...HEAD | grep -qE '^(src|migrations)/'; then
  if ! git diff --name-only --diff-filter=A "$base"...HEAD | grep -qE '^changes/[0-9]+\.(feature|fix|removal|security)\.md$'; then
    echo "This change touches src/ or migrations/ but adds no news fragment in changes/." >&2
    exit 1
  fi
fi
