diff --git a/webhooks/sender.py b/webhooks/sender.py
index 3c1e2aa..8f04b19 100644
--- a/webhooks/sender.py
+++ b/webhooks/sender.py
@@ -1,22 +1,48 @@
 import logging
+import random
+import time
 
 import httpx
 
 log = logging.getLogger(__name__)
 
+MAX_ATTEMPTS = 5
+BASE_DELAY_SECONDS = 2.0
+RETRYABLE_STATUS = {429, 500, 502, 503, 504}
+
+
+def _backoff(attempt):
+    """Exponential backoff with jitter: about 2, 4, 8, 16 seconds between attempts."""
+    return BASE_DELAY_SECONDS * (2 ** (attempt - 1)) * random.uniform(0.8, 1.2)
+
 
 def deliver(endpoint, event, client=None):
     client = client or httpx.Client(timeout=10.0)
-    try:
-        response = client.post(endpoint.url, json=event.payload,
-                               headers={"X-Event-Id": event.id})
-    except httpx.TransportError as exc:
-        log.warning("webhook %s to %s failed: %s", event.id, endpoint.url, exc)
-        return False
-    if response.status_code >= 400:
-        log.warning("webhook %s to %s got %s", event.id, endpoint.url, response.status_code)
-        return False
-    return True
+    for attempt in range(1, MAX_ATTEMPTS + 1):
+        try:
+            response = client.post(endpoint.url, json=event.payload,
+                                   headers={"X-Event-Id": event.id,
+                                            "X-Delivery-Attempt": str(attempt)})
+        except httpx.TransportError as exc:
+            log.warning("webhook %s to %s attempt %d failed: %s",
+                        event.id, endpoint.url, attempt, exc)
+        else:
+            if response.status_code < 400:
+                return True
+            if response.status_code not in RETRYABLE_STATUS:
+                log.warning("webhook %s to %s got %s, not retrying",
+                            event.id, endpoint.url, response.status_code)
+                return False
+            log.warning("webhook %s to %s attempt %d got %s",
+                        event.id, endpoint.url, attempt, response.status_code)
+        if attempt < MAX_ATTEMPTS:
+            time.sleep(_backoff(attempt))
+    log.error("webhook %s to %s gave up after %d attempts",
+              event.id, endpoint.url, MAX_ATTEMPTS)
+    return False
diff --git a/tests/test_sender.py b/tests/test_sender.py
index 51aa0c2..d93e7f0 100644
--- a/tests/test_sender.py
+++ b/tests/test_sender.py
@@ -30,3 +30,38 @@ def test_success_returns_true(fake_client, endpoint, event):
     assert deliver(endpoint, event, client=fake_client) is True
+
+
+def test_retries_5xx_then_succeeds(fake_client, endpoint, event, no_sleep):
+    fake_client.responses = [503, 502, 200]
+    assert deliver(endpoint, event, client=fake_client) is True
+    assert fake_client.attempts == 3
+
+
+def test_gives_up_after_five_attempts(fake_client, endpoint, event, no_sleep):
+    fake_client.responses = [500] * 10
+    assert deliver(endpoint, event, client=fake_client) is False
+    assert fake_client.attempts == 5
+
+
+def test_does_not_retry_404(fake_client, endpoint, event, no_sleep):
+    fake_client.responses = [404, 200]
+    assert deliver(endpoint, event, client=fake_client) is False
+    assert fake_client.attempts == 1
+
+
+def test_retries_timeouts(fake_client, endpoint, event, no_sleep):
+    fake_client.responses = [httpx.ReadTimeout("slow"), 200]
+    assert deliver(endpoint, event, client=fake_client) is True
+
+
+def test_sends_attempt_header(fake_client, endpoint, event, no_sleep):
+    fake_client.responses = [503, 200]
+    deliver(endpoint, event, client=fake_client)
+    assert fake_client.headers[-1]["X-Delivery-Attempt"] == "2"
