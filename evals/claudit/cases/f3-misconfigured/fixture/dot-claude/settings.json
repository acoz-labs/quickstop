{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Write(src/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ["Edit", "Write"],
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent"
          }
        ]
      }
    ]
  }
}
