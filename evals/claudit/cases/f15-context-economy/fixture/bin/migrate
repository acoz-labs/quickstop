#!/usr/bin/env bash
# bin/migrate new <name> | bin/migrate bindings
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
  new)
    next=$(printf '%04d' $(( $(ls migrations | wc -l) + 1 )))
    printf -- '-- forward\n\n-- reverse\n' > "migrations/${next}_${2:?name}.sql"
    echo "migrations/${next}_$2.sql" ;;
  bindings) echo "regenerated src/orchard/generated/" ;;
  *) echo "usage: bin/migrate new <name> | bin/migrate bindings" >&2; exit 64 ;;
esac
