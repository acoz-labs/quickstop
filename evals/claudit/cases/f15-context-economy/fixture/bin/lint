#!/usr/bin/env python3
"""Compile-check every hand-written Python file outside the exempt folders."""
import pathlib
import py_compile
import sys

EXEMPT = ('src/orchard/vendor/', 'src/orchard/generated/', 'tests/data/', 'migrations/')

failed = False
for path in sorted(pathlib.Path('.').glob('**/*.py')):
    name = path.as_posix()
    if name.startswith(EXEMPT):
        continue
    try:
        py_compile.compile(name, doraise=True)
    except py_compile.PyCompileError as error:
        print(error, file=sys.stderr)
        failed = True
sys.exit(1 if failed else 0)
