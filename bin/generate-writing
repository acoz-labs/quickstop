#!/usr/bin/env python3
"""Copy the single writing source into self-contained native packages."""
import argparse
import json
import shutil
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "src/writing-for-humans"
TARGETS = ("claude-code", "codex", "pi")


def json_file(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n")


def generate(target, destination):
    shutil.copytree(SOURCE / "skills", destination / "skills")
    refs = destination / "skills/writing-for-humans/references"
    shutil.copyfile(SOURCE / "core.md", refs / "core.md")
    shutil.copyfile(SOURCE / "examples.md", refs / "examples.md")
    shutil.copyfile(ROOT / "LICENSE", destination / "LICENSE")
    setup = destination / "skills/writing-setup/references"
    setup.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SOURCE / "setup" / (target + ".md"), setup / "setup.md")
    shutil.copyfile(SOURCE / "readmes" / (target + ".md"), destination / "README.md")
    manifest = {"name": "writing-for-humans", "version": "0.1.0",
                "description": "Make all prose understandable while preserving facts and exact formats.",
                "license": "MIT"}
    runtime = destination / "runtime"
    runtime.mkdir()
    if target == "pi":
        shutil.copyfile(SOURCE / "runtime/pi.mjs", runtime / "pi.mjs")
        json_file(destination / "package.json", {
            **manifest, "type": "module", "keywords": ["pi-package"],
            "engines": {"node": ">=22"},
            "pi": {"extensions": ["./runtime/pi.mjs"], "skills": ["./skills"]}})
    else:
        shutil.copyfile(SOURCE / "runtime/hook.mjs", runtime / "hook.mjs")
        events = ["SessionStart", "SubagentStart"]
        if target == "claude-code":
            events.append("UserPromptSubmit")
            json_file(destination / ".claude-plugin/plugin.json", manifest)
        else:
            json_file(destination / "plugin.json", {
                "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
                **manifest, "extensions": {"com.openai": {"hooks": "./hooks/hooks.json"}}})
        variable = "CLAUDE_PLUGIN_ROOT" if target == "claude-code" else "PLUGIN_ROOT"
        hooks = {}
        for event in events:
            handler = {"type": "command", "command": 'node "${' + variable + '}/runtime/hook.mjs" ' + event,
                       "timeout": 5}
            hooks[event] = [{"hooks": [handler]}]
        json_file(destination / "hooks/hooks.json", {"hooks": hooks})


def files(root):
    return {p.relative_to(root).as_posix(): p.read_bytes() for p in root.rglob("*") if p.is_file()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--write", action="store_true")
    args = parser.parse_args()
    drift = []
    with tempfile.TemporaryDirectory(prefix="writing-build-") as tmp:
        for target in TARGETS:
            staged = Path(tmp) / target
            staged.mkdir()
            generate(target, staged)
            installed = ROOT / "plugins" / target / "writing-for-humans"
            if args.write:
                if installed.exists():
                    shutil.rmtree(installed)
                shutil.copytree(staged, installed)
            elif files(staged) != files(installed):
                drift.append(target)
    if drift:
        parser.exit(1, "Generated writing packages differ: " + ", ".join(drift) + "; run bin/generate-writing --write\n")
    print("Writing packages match shared source.")


if __name__ == "__main__":
    main()
