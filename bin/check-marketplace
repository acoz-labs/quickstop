#!/usr/bin/env python3
"""Check the Quickstop catalog, target packages and generated native indexes."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys

# Quickstop targets Claude Code only. Another agent tool is added only once its plugins can be tested in that tool.
FORMATS = {'claude-code': {'claude-plugin': '.claude-plugin/plugin.json'}}
OUTPUTS = ('.claude-plugin/marketplace.json', 'docs/catalog.md')


class Invalid(ValueError):
    pass


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise Invalid(f'duplicate JSON key: {key}')
        result[key] = value
    return result


def decode(text):
    value = json.loads(text, object_pairs_hook=unique_object)
    if not isinstance(value, dict):
        raise Invalid('expected a JSON object')
    return value


def read_json(path):
    try:
        return decode(path.read_text())
    except (OSError, ValueError) as exc:
        raise Invalid(f'{path.name}: invalid or missing JSON: {exc}') from exc


def require(value, message):
    if not value:
        raise Invalid(message)


def fields(value, expected, label):
    require(isinstance(value, dict) and set(value) == set(expected), f'{label}: expected fields {expected}')


def line(value):
    return isinstance(value, str) and bool(value.strip()) and '\n' not in value and '\r' not in value


def version(value):
    # Released Quickstop packages currently use stable SemVer.
    require(isinstance(value, str) and re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', value), f'invalid stable version: {value!r}')
    return tuple(map(int, value.split('.')))


def safe_path(root, value):
    require(isinstance(value, str) and value and not value.startswith('/'), 'expected relative path')
    parts = value.split('/')
    require(all(part not in ('', '.', '..') for part in parts) and '\\' not in value, f'unsafe path: {value}')
    path = root
    for part in parts:
        path = path / part
        require(not path.is_symlink(), f'symlink refused: {value}')
    require(path.resolve().is_relative_to(root.resolve()), f'path escapes root: {value}')
    return path


def component_path(package, value):
    require(isinstance(value, str) and value.startswith('./'), 'component paths must start with ./')
    path = safe_path(package, value[2:].rstrip('/'))
    require(path.exists(), f'missing component: {value}')
    return path


def git(root, *args, stdin=None):
    # Replace refs would let a local ref rewrite published history and package bytes.
    result = subprocess.run(['git', '-C', str(root), '--no-replace-objects', *args], input=stdin, capture_output=True, text=True)
    require(result.returncode == 0, 'Git comparison failed; supply an existing commit with --base')
    return result.stdout


def validate_resources(package, manifest):
    allowed = {'skills': (str, list), 'agents': (str, list), 'hooks': (str, list, dict), 'mcpServers': (str, list, dict)}
    for key, types in allowed.items():
        if key not in manifest:
            continue
        value = manifest[key]
        require(isinstance(value, types), f'{key}: invalid resource declaration type')
        if isinstance(value, str):
            component_path(package, value)
        elif isinstance(value, list):
            for item in value:
                component_path(package, item)
        elif key == 'mcpServers':
            require(all(isinstance(server, dict) for server in value.values()), 'inline MCP servers must be objects')
        elif key == 'hooks':
            require(isinstance(value.get('hooks'), dict), 'inline hooks need a hooks object')


def package_manifest(root, plugin, harness, target):
    fields(target, ('format', 'path', 'acceptance'), 'target')
    require(harness in FORMATS, f"{plugin['name']}: unsupported target {harness!r}; Quickstop supports only claude-code")
    require(target['format'] in FORMATS[harness], f"{plugin['name']}: unsupported {harness} format {target['format']!r}")
    require(isinstance(target['path'], str) and target['path'].startswith('plugins/'), 'packages must live under plugins/')
    package = safe_path(root, target['path'])
    require(package.is_dir(), f'missing package: {target["path"]}')
    for path in package.rglob('*'):
        require(not path.is_symlink(), f'package symlink refused: {path.name}')
    acceptance = safe_path(root, target['acceptance'])
    require(acceptance.is_file() and acceptance.suffix == '.md' and acceptance.read_text().strip(), 'target needs a nonempty Markdown acceptance procedure')
    manifest = read_json(package / FORMATS[harness][target['format']])
    require(manifest.get('name') == plugin['name'], f'{plugin["name"]}: manifest name mismatch')
    version(manifest.get('version'))
    require(line(manifest.get('description')), 'manifest needs a description')
    require((package / 'README.md').is_file(), 'package needs README.md')
    if manifest.get('license'):
        require((package / 'LICENSE').is_file(), 'declared license needs LICENSE')
    # Validate declared file resources without claiming the complete host schema.
    validate_resources(package, manifest)
    skill_roots = {package / 'skills'}
    declared_skills = manifest.get('skills', [])
    if isinstance(declared_skills, str):
        declared_skills = [declared_skills]
    for value in declared_skills:
        skill_roots.add(component_path(package, value))
    documents = list((package / 'agents').rglob('*.md'))
    for directory in skill_roots:
        if directory.is_dir():
            for skill in directory.iterdir():
                if skill.is_dir():
                    require((skill / 'SKILL.md').is_file(), f'{skill.name}: missing SKILL.md')
            documents.extend(directory.glob('*/SKILL.md'))
    for document in documents:
        content = document.read_text()
        require(content.startswith('---\n') and '\n---\n' in content[4:], f'{document.name}: missing frontmatter')
        header = content.split('\n---\n', 1)[0]
        for key in ('name', 'description'):
            require(re.search(rf'^{key}:\s*\S', header, re.M), f'{document.name}: missing {key}')
    return manifest


def load_catalog(root):
    catalog = read_json(root / 'catalog.json')
    fields(catalog, ('schema', 'name', 'display_name', 'description', 'plugins'), 'catalog')
    require(catalog['schema'] == 1 and type(catalog['schema']) is int, 'unsupported catalog schema')
    require(catalog['name'] == 'quickstop', 'marketplace identity must stay quickstop')
    require(line(catalog['display_name']) and line(catalog['description']), 'catalog presentation required')
    require(isinstance(catalog['plugins'], list), 'plugins must be a list')
    names, packages = set(), {}
    for plugin in catalog['plugins']:
        fields(plugin, ('name', 'description', 'category', 'targets'), 'plugin')
        name = plugin['name']
        require(isinstance(name, str) and re.fullmatch(r'[a-z][a-z0-9]*(-[a-z0-9]+)*', name) and name not in names, 'plugin names must be unique lowercase kebab-case')
        names.add(name)
        require(line(plugin['description']) and line(plugin['category']), 'plugin description/category required')
        require(isinstance(plugin['targets'], dict) and plugin['targets'], 'declare at least one supported target')
        for harness, target in plugin['targets'].items():
            manifest = package_manifest(root, plugin, harness, target)
            packages[name, harness] = (target, manifest)
    roots = {target['path'] for target, _ in packages.values()}
    for left in roots:
        for right in roots:
            require(left == right or not right.startswith(left + '/'), 'package roots must not overlap')
    # Every native manifest in the distribution tree must belong to a declared target.
    expected = {target['path'] + '/' + FORMATS[harness][target['format']]
                for (_, harness), (target, _) in packages.items()}
    for path in (root / 'plugins').rglob('*'):
        require(not path.is_symlink(), 'symlink in distribution tree')
        if path.is_file():
            rel = path.relative_to(root).as_posix()
            require(any(rel.startswith(p + '/') for p in roots), f'unregistered distribution file: {rel}')
            if path.name == 'plugin.json' and path.parent.name == '.claude-plugin':
                require(rel in expected, f'undeclared native manifest: {rel}')
    return catalog, packages


def projections(catalog, packages, releases=None):
    claude = []
    rows = ['# Plugin catalog', '', 'Generated from `catalog.json`, `releases.json` and native manifests. Do not edit by hand.', '',
            'Every plugin targets Claude Code. Versions are per package.', '',
            '| Plugin | Purpose | Claude Code |', '| --- | --- | --- |']
    for plugin in catalog['plugins']:
        name = plugin['name']
        target, manifest = packages[name, 'claude-code']
        released = releases.get((name, 'claude-code')) if releases is not None else None
        if releases is not None and released is None:
            cell = 'Not released'
        else:
            if released:
                target, manifest = released['target'], released['manifest']
            cell = f'[{manifest["version"]}](../{target["acceptance"]})'
            entry = {'name': name, 'version': manifest['version'], 'description': plugin['description'], 'source': './' + target['path']}
            if manifest.get('keywords'):
                entry['keywords'] = manifest['keywords']
            if released:
                entry['source'] = {'source': 'git-subdir', 'url': REPOSITORY_URL, 'path': target['path'], 'sha': released['commit']}
            claude.append(entry)
        rows.append('| ' + ' | '.join([name, plugin['description'].replace('|', '\\|'), cell]) + ' |')
    json_text = lambda value: json.dumps(value, indent=2, ensure_ascii=False) + '\n'
    return dict(zip(OUTPUTS, [json_text({'name': catalog['name'], 'owner': {'name': 'acoz-labs', 'url': 'https://github.com/acoz-labs'}, 'description': catalog['description'], 'plugins': claude}),
                              '\n'.join(rows) + '\n']))


REPOSITORY_URL = 'https://github.com/acoz-labs/quickstop.git'


def is_bytecode(relative):
    """Bytecode caches are local runtime state, never distributed bytes."""
    return relative.suffix == '.pyc' or '__pycache__' in relative.parts


def package_digest(root, path, commit=None):
    """Hash sorted relative names, executable modes and file SHA-256s, not tar metadata."""
    records = []
    if commit:
        entries = git(root, 'ls-tree', '-r', '-z', commit, '--', path).split('\0')
        for entry in filter(None, entries):
            metadata, name = entry.split('\t', 1)
            mode, kind, oid = metadata.split()
            require(kind == 'blob' and mode in ('100644', '100755'), 'artifact contains unsupported file type')
            content = subprocess.run(['git', '-C', str(root), '--no-replace-objects', 'cat-file', 'blob', oid], check=True, capture_output=True).stdout
            records.append([name[len(path) + 1:], mode, hashlib.sha256(content).hexdigest()])
    else:
        package = safe_path(root, path)
        for item in package.rglob('*'):
            require(not item.is_symlink(), 'artifact contains symlink')
            if item.is_file() and not is_bytecode(item.relative_to(package)):
                records.append([item.relative_to(package).as_posix(), '100755' if item.stat().st_mode & 0o111 else '100644', hashlib.sha256(item.read_bytes()).hexdigest()])
    require(records, 'empty artifact')
    return hashlib.sha256(json.dumps(sorted(records), separators=(',', ':'), ensure_ascii=True).encode()).hexdigest()


def published_provenance(root):
    """Every provenance any lock reachable from HEAD gave each published commit, version and package digest.

    Reads releases.json in every reachable commit, not a path-limited log, so merges and history
    simplification can't hide a publication. A shallow clone can't prove that and is refused.
    """
    require(git(root, 'rev-parse', '--is-shallow-repository').strip() == 'false',
            'release-lock verification needs full history; fetch with --unshallow')
    require(not Path(root, git(root, 'rev-parse', '--git-path', 'info/grafts').strip()).exists(),
            'release-lock verification refuses a repository with grafts')
    commits = git(root, 'rev-list', 'HEAD').split()
    found = git(root, 'cat-file', '--batch-check', stdin=''.join(f'{commit}:releases.json\n' for commit in commits))
    seen = {}
    for blob in sorted({line.split()[0] for line in found.splitlines() if line.split()[1:2] == ['blob']}):
        try:
            records = decode(git(root, 'cat-file', 'blob', blob)).get('releases')
        except ValueError:
            continue  # a malformed historical lock publishes nothing
        for record in records if isinstance(records, list) else []:
            if isinstance(record, dict):
                for key in published_keys(record):
                    seen.setdefault(key, set()).add(json.dumps(record.get('provenance'), sort_keys=True))
    return seen


def published_keys(record):
    """A release is one commit, one version and one package digest; none of them can be re-accepted."""
    manifest = record.get('manifest') if isinstance(record.get('manifest'), dict) else {}
    target = record.get('name'), record.get('harness')
    keys = [(*target, 'commit', record.get('commit')), (*target, 'version', manifest.get('version')),
            (*target, 'sha256', record.get('sha256'))]
    return [key for key in keys if isinstance(key[3], str)]


def load_releases(root, packages):
    lock = read_json(root / 'releases.json')
    fields(lock, ('schema', 'releases'), 'release lock')
    require(lock['schema'] == 1 and isinstance(lock['releases'], list), 'unsupported release lock')
    releases = {}
    published = published_provenance(root)
    for record in lock['releases']:
        fields(record, ('name', 'harness', 'commit', 'sha256', 'target', 'manifest', 'provenance'), 'release')
        key = record['name'], record['harness']
        require(key in packages and key not in releases, 'release must identify one registered target')
        require(re.fullmatch('[0-9a-f]{40}', record['commit']) is not None, 'release requires full commit')
        require(re.fullmatch('[0-9a-f]{64}', record['sha256']) is not None, 'release requires SHA-256')
        target = record['target']
        fields(target, ('format', 'path', 'acceptance'), 'released target')
        require(target['format'] in FORMATS[key[1]], 'invalid released format')
        safe_path(root, target['path'])
        require(target['path'].startswith('plugins/'), 'released package must be under plugins/')
        require(package_digest(root, target['path'], record['commit']) == record['sha256'], 'released package digest mismatch')
        snapshot = decode(git(root, 'show', f'{record["commit"]}:catalog.json'))
        declared = {(p['name'], h): t for p in snapshot['plugins'] for h, t in p['targets'].items()}
        require(declared.get(key) == target, 'released target differs from candidate catalog')
        actual = decode(git(root, 'show', f'{record["commit"]}:{target["path"]}/{FORMATS[key[1]][target["format"]]}'))
        version(actual.get('version'))
        require(actual == record['manifest'] and actual['name'] == key[0], 'released manifest mismatch')
        provenance = record['provenance']
        require(isinstance(provenance, dict), 'release provenance required')
        if provenance.get('kind') == 'legacy-preserved':
            require(key == ('claudit', 'claude-code') and record['commit'] == 'b7370388e26ccac0ebf2c48a6b86942eb7259a9d' and actual['version'] == '3.0.0', 'legacy exception only preserves existing Claudit')
        else:
            fields(provenance, ('kind', 'issue', 'artifact', 'acceptance'), 'acceptance provenance')
            require(provenance['kind'] == 'sdlc-accepted' and type(provenance['issue']) is int and provenance['issue'] > 0, 'independent acceptance required')
            require(re.fullmatch('sha256:[0-9a-f]{64}', provenance['artifact']) is not None, 'immutable accepted archive required')
            require(isinstance(provenance['acceptance'], str) and re.fullmatch(r'https://github.com/acoz-labs/quickstop/issues/' + str(provenance['issue']) + r'#issuecomment-[0-9]+', provenance['acceptance']), 'authenticated acceptance receipt link required')
        # A published release keeps its provenance; a new acceptance needs a new candidate commit.
        for pin in published_keys(record):
            history = published.get(pin, set())
            require(len(history) <= 1, f'{key}: history gives {pin[2]} {pin[3]} more than one provenance')
            require(history <= {json.dumps(provenance, sort_keys=True)},
                    f'{key}: provenance differs from the published record for {pin[2]} {pin[3]}')
        releases[key] = record
    return releases


def fingerprint(root, path, base=None):
    if base:
        names = git(root, 'ls-tree', '-r', '--name-only', '-z', base, '--', path).split('\0')
        return {name[len(path)+1:]: git(root, 'rev-parse', f'{base}:{name}').strip() for name in names if name}
    package = safe_path(root, path)
    return {p.relative_to(package).as_posix(): git(root, 'hash-object', str(p)).strip()
            for p in package.rglob('*') if p.is_file() and not is_bytecode(p.relative_to(package))}


def check_versions(root, packages, base):
    base = git(root, 'rev-parse', '--verify', f'{base}^{{commit}}').strip()
    if git(root, 'ls-tree', '--name-only', base, '--', 'catalog.json').strip():
        previous = decode(git(root, 'show', f'{base}:catalog.json'))
        old_targets = {(p['name'], h): t for p in previous['plugins'] for h, t in p['targets'].items()}
    else:
        # Explicit migration from the former Claude-only marketplace, never a Git-error fallback.
        previous = decode(git(root, 'show', f'{base}:.claude-plugin/marketplace.json'))
        old_targets = {(p['name'], 'claude-code'): {'format': 'claude-plugin', 'path': p['source'].removeprefix('./')} for p in previous['plugins']}
    for key, (target, manifest) in packages.items():
        if key not in old_targets:
            continue
        old = old_targets[key]
        old_manifest = decode(git(root, 'show', f'{base}:{old["path"]}/{FORMATS[key[1]][old["format"]]}'))
        before, after = version(old_manifest['version']), version(manifest['version'])
        require(after >= before, f'{key}: version downgrade')
        if fingerprint(root, old['path'], base) != fingerprint(root, target['path']):
            require(after > before, f'{key}: changed distributed files require a higher version')


def validate(root, base=None, write=False):
    root = root.resolve()
    catalog, packages = load_catalog(root)
    if base:
        check_versions(root, packages, base)
    releases = load_releases(root, packages)
    outputs = projections(catalog, packages, releases)
    paths = {name: safe_path(root, name) for name in outputs}
    if write:
        for name, path in paths.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(outputs[name])
    else:
        for name, path in paths.items():
            require(path.is_file() and path.read_text() == outputs[name], f'generated index drift: {name}; run bin/check-marketplace --write')
    return len(catalog['plugins'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--base', help='known pre-change commit; compare each declared package independently')
    parser.add_argument('--write', action='store_true', help='regenerate native indexes and catalog table after validation')
    args = parser.parse_args()
    try:
        count = validate(args.root, args.base, args.write)
    except (Invalid, OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
        print(f'Marketplace validation failed: {exc}', file=sys.stderr)
        return 1
    print(f'Marketplace valid: {count} plugin(s)' + ('; package versions checked' if args.base else ''))
    return 0


PROBE = 'import platform, sys; print(platform.python_version(), sys.executable)'


def find_python(expected, path=None):
    """Return the executable of an interpreter whose version is exactly expected, or None."""
    names = (f"python{'.'.join(expected.split('.')[:2])}", 'python3', 'python')
    candidates = [Path(d) / name for d in os.get_exec_path({'PATH': path} if path is not None else None) for name in names]
    mise = shutil.which('mise', path=path)
    if mise:
        where = subprocess.run([mise, 'where', f'python@{expected}'], capture_output=True, text=True)
        if where.returncode == 0 and where.stdout.strip():
            candidates.append(Path(where.stdout.strip()) / 'bin/python3')
    for candidate in candidates:
        if not os.access(candidate, os.X_OK) or candidate.is_dir():
            continue
        try:
            probe = subprocess.run([str(candidate), '-c', PROBE], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            continue
        version, _, executable = probe.stdout.strip().partition(' ')
        if probe.returncode == 0 and version == expected:
            return executable
    return None


def use_pinned_python():
    """Re-exec under the Python pinned in .python-version unless already running it."""
    pin = Path(__file__).resolve().parent.parent / '.python-version'
    expected = pin.read_text().strip()
    if platform.python_version() == expected:
        return
    executable = find_python(expected)
    if executable is None:
        sys.exit(f'Python {expected} (pinned in .python-version) not found on PATH or through mise; '
                 f'install it, for example with: mise install python@{expected}')
    os.execv(executable, [executable, str(Path(__file__).resolve()), *sys.argv[1:]])


if __name__ == '__main__':
    use_pinned_python()
    sys.exit(main())
