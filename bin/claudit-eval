#!/usr/bin/env python3
"""Run the Claudit `claude plugin eval` suite on one arm, summarize a result, or run and grade headless audits.

The doctor-combined arm (#192) runs headless outside `claude plugin eval`: `/doctor` and `/doctor prompt-audit .`
in each scaffolded fixture, graded as one report by the same graders and the same judge prompt."""
import sys

if sys.version_info < (3, 11):
    sys.exit('claudit-eval requires Python 3.11+; put the pinned interpreter first in PATH')

import argparse
import concurrent.futures
import datetime as dt
import fnmatch
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import re
import shlex
import statistics
import shutil
import subprocess
import tempfile
import threading
import time

ROOT = Path(__file__).resolve().parent.parent
SUITE = ROOT / 'evals/claudit'
DEFAULT_PLUGIN = ROOT / 'plugins/claudit'
PROMPT_KEY = '    prompt: '
TOOLS_LINE = '    allowed_tools: [Read, Glob, Grep, Skill, Task, Agent, Bash]'
WEB_FETCH_RULE = 'WebFetch(domain:code.claude.com)'
CANONICAL_PROMPT = PROMPT_KEY + "Review this project's Claude Code setup and tell me what to improve."
STUB_MANIFEST = {'name': 'claudit-eval-no-plugin', 'version': '0.0.0',
                 'description': 'Empty plugin for the no-plugin eval arms.'}
ARMS = ('plain', 'doctor', 'claudit', 'doctor-combined', 'claudit-deep')
PLUGIN_ARMS = ('claudit', 'claudit-deep')
HEADLESS_ARMS = ('doctor-combined', 'claudit-deep')  # run outside claude plugin eval
DEFAULT_JUDGE = 'claude-haiku-5-5'
STRUCTURE = ('structure-alignment', 'structure-correctness', 'structure-coverage', 'structure-intent',
             'structure-plan-length')
# Tests set this to avoid copying the ~80 MB interpreter; real runs always copy it.
NO_PYTHON_COPY = 'CLAUDIT_EVAL_NO_PYTHON_COPY'
HELPER = 'skills/claudit/scripts/claudit.py'
# The accepted headless method (#156, #168): normal login, candidate bytes, no user settings or MCP servers.
HEADLESS_FLAGS = ('--setting-sources', 'project,local', '--strict-mcp-config', '--no-session-persistence',
                  '--permission-mode', 'default', '--output-format', 'json', '--allowedTools', 'Read', 'Grep', 'Glob')
# The doctor-combined arm (#192): both built-in reviews, headless and read-only, graded as one report.
DOCTOR_PROMPTS = ('/doctor', '/doctor prompt-audit .')
DOCTOR_FLAGS = ('--setting-sources', 'project', '--disallowedTools', 'Edit', 'Write', 'NotebookEdit',
                '--strict-mcp-config', '--no-session-persistence', '--output-format', 'json')
CALL_TIMEOUT = 1500  # seconds, as each case's timeout_seconds
# The claudit-deep arm (#193): Claudit's --deep mode, headless as the accepted `headless` method runs Claudit, in the
# same throwaway scaffolds as doctor-combined. Its nested `/doctor prompt-audit .` runs with doctor-combined's flags
# (untrusted folder, Bash denied); `claude plugin eval`'s sandbox has no network, so a nested `claude -p` can't run
# there. The helper appends the nested call's cost and time to this file.
DEFAULT_INVOKE = '/claudit:claudit --read-only'
DEEP_INVOKE = DEFAULT_INVOKE + ' --deep'
DEEP_RECORD = 'CLAUDIT_DEEP_RECORD'
DEEP_MODEL = 'CLAUDIT_DEEP_MODEL'  # pins the nested prompt-audit to the arm's model
NESTED_FIELDS = ('status', 'model', 'max_budget_usd', 'cost_usd', 'seconds', 'permission_denials')
# The judge `claude plugin eval` 2.1.317 uses for an llm grader: this system prompt, this user prompt (the focus is the
# final message, `last_message`), three votes, PASS by majority; a vote passes when it says PASS and not FAIL.
JUDGE_SYSTEM = 'You are a strict, terse evaluation judge for coding-agent traces.'
JUDGE_PROMPT = ('You are grading the output of a coding agent against a criterion.\n\nCriterion:\n{criteria}\n\n\n'
                'Agent output (last_message):\n{output}\n\n\nRespond with exactly one word: PASS or FAIL.')
JUDGE_VOTES = 3
JUDGE_FLAGS = ('--system-prompt', JUDGE_SYSTEM, '--tools', '', '--setting-sources', 'project', '--strict-mcp-config',
               '--no-session-persistence', '--disable-slash-commands', '--output-format', 'json')
INSTRUCTION_FILES = ('CLAUDE.md', 'AGENTS.md', '.claude/CLAUDE.md')

# Script graders built from a scan (Claudit 4.1): the report must carry the scan's plan, grades and footer.
TOP = r'(?:^|\n)#{2,3}[ \t]+(?:The )?Top(?: [0-9]+)? changes[^\n]*'
SECTION_END = r'(?=\n#{1,2}[ \t]|\n[-*_]{3,}[ \t]*(?:\n|(?![\s\S]))|\n?(?![\s\S]))'
NOT_ITEM = r'(?:(?!\n(?:#{3,4}[ \t]+)?(?:\*\*)?[0-9]+[.)][ \t]|\n#{1,2}[ \t]|\n[-*_]{3,}[ \t]*(?:\n|(?![\s\S])))[\s\S])*'
GRADE_RAISE = (r'(?:^|\n)[ \t]*[-*][ \t]+\*\*(?:Correctness|Alignment|Coverage): [B-F]\*\*'
               r'(?![^\n]*\bitems?[ \t]+#?[0-9])')


def title_pattern(title):
    """A plan title, word for word; a word with a dot or slash (a path) may be backticked."""
    words = []
    for word in title.split(' '):
        escaped = re.escape(word).replace('\\-', '-')
        words.append('\\x60?%s\\x60?' % escaped if re.search(r'[./]', word) else escaped)
    return '[ \\t]+'.join(words)


def plan_items_pattern(titles):
    """Top changes holds exactly these items, numbered 1 to N in this order, or the no-changes line."""
    if not titles:
        return TOP + r'\n(?:[ \t]*\n)*[ \t]*(?:>[ \t]*)?(?:\*\*|\*|_)?No changes worth making' + NOT_ITEM + SECTION_END
    items = ''.join(r'\n(?:#{3,4}[ \t]+)?(?:\*\*)?%d[.)][ \t]+(?:\*\*)?%s(?:\*\*|[ \t]*(?=\(|\n|(?![\s\S])))'
                    % (n, title_pattern(t)) + NOT_ITEM for n, t in enumerate(titles, 1))
    return TOP + NOT_ITEM + items + SECTION_END


def footer_pattern(version):
    return (r'(?:^|\n)[-*_]{3,}[ \t]*\n(?:[^\n]*\n)*?[^\n]*\bClaudit ' + re.escape(version)
            + r'; audited commit \x60?[0-9a-f]{40}\b')


def declined_pattern(refs):
    body = r'(?:(?!\n#{1,2}[ \t])[\s\S])*?'
    return r'(?:^|\n)#{2,3}[ \t]+Declined by the project[^\n]*' + ''.join(
        r'(?=%s\x60?%s\b)' % (body, re.escape(ref)) for ref in refs)


# Claudit 4.2: each declined entry's reason, its Worth reconsidering note when the scan gives one and never
# otherwise, and the decline cited in a plan item it left behind. A Source: line never satisfies a cue.
DECLINED_TOP = r'(?:^|\n)#{2,3}[ \t]+Declined by the project[^\n]*'
DECLINED_BODY = r'(?:(?!\n#{1,2}[ \t])[\s\S])*?'
ENTRY = r'(?:(?!\n[-*][ \t]|\n#{1,2}[ \t]|\n[-*_]{3,}[ \t]*(?:\n|(?![\s\S])))[\s\S])*?'
# Any reconsider or revisit fails, wherever it is, unless a plain negation directly governs it ("not worth
# reconsidering", "do not revisit", "no need to revisit", "nothing to reconsider"); a negation elsewhere on the line
# doesn't count. A line that asks ("Why not reconsider ...", "Is it not worth revisiting ...?") always fails.
RECONSIDER_WORD = r'\b(?:reconsider|revisit)\w*'
RECONSIDER_FREE = (r'(?:^|\n)(?:[^\n]*\bwhy not\b[^\n]*%s|[^\n]*%s[^\n]*\?[ \t]*(?=\n|(?![\s\S]))'
                   r'|[^\n]*?(?<!not worth )(?<!do not )(?<!does not )(?<!should not )(?<!no need to )(?<!nothing to )'
                   r'(?<!nothing is worth )(?<!nothing here is worth )%s)' % (RECONSIDER_WORD, RECONSIDER_WORD,
                                                                              RECONSIDER_WORD))


def words_pattern(text, limit=6):
    """The first words of a quoted text, with any quotes, backticks, emphasis or wrapping between them."""
    words = re.findall(r"[\w'\u2019./-]+", text.split(' \u2026 ')[0])[:limit]
    return r'[\s\x60"\u201c\u201d*_]+'.join(
        re.escape(w.replace('\u2019', "'")).replace("'", "['\\u2019]") for w in words)


def entry_cue(entry, cue):
    """Lookahead: a declined entry (from its path:line to the next bullet or section) that holds the cue."""
    ref = '%s:%d' % (entry['path'], entry['line'])
    return r'(?=%s\x60?%s\b%s%s)' % (DECLINED_BODY, re.escape(ref), ENTRY, cue)


def reason_cue(entry):
    lead = r'\bReason(?:\*\*)?:(?:\*\*)?[ \t]*["\u201c\x60*_]*'
    if entry['reason'] == 'no reason given':
        return entry_cue(entry, lead + 'no reason given')
    return entry_cue(entry, lead + words_pattern(entry['reason']))


def reconsider_cue(entry):
    evidence = entry['reconsider']['evidence']
    cue = (re.escape(evidence['url']) if 'url' in evidence
           else r'\x60?%s\b' % re.escape('%s:%d' % (evidence['path'], evidence['line'])))
    return entry_cue(entry, r'\bWorth reconsidering\b' + ENTRY + cue)


def evidence_text(reconsider):
    evidence = reconsider['evidence']
    return evidence['url'] if 'url' in evidence else '`%s:%d`' % (evidence['path'], evidence['line'])


def no_reconsider_cue(entry):
    return entry_cue(entry, r'\b(?:reconsider\w*|revisit\w*)')


def declined_cues(cues):
    """The Declined by the project section, holding every cue."""
    return DECLINED_TOP + ''.join(cues)


def defect_cited_pattern(number, item):
    ref = '%s:%d' % (item['declined']['path'], item['declined']['line'])
    return (TOP + NOT_ITEM + r'\n(?:#{3,4}[ \t]+)?(?:\*\*)?%d[.)][ \t]+(?:\*\*)?%s' % (number, title_pattern(item['title']))
            + r'(?:(?!\n(?:#{3,4}[ \t]+)?(?:\*\*)?[0-9]+[.)][ \t]|\n#{1,2}[ \t]|\n[-*_]{3,})[\s\S])*?'
            + r'\n(?![ \t]*(?:[-*][ \t]+)?(?:\*\*)?Source\b)[^\n]*\x60?%s\b' % re.escape(ref))


class Failure(Exception):
    pass


def positive_cost(value):
    cost = float(value)
    if not (math.isfinite(cost) and cost > 0):
        raise argparse.ArgumentTypeError('cost ceiling must be greater than 0')
    return cost


def positive_int(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError('must be at least 1')
    return number


def copy_python(target):
    if os.environ.get(NO_PYTHON_COPY) == '1':
        return Path(sys.executable)

    def ignore(directory, names):
        if Path(directory).name == 'site-packages':
            return set(names)
        return {name for name in names if name == '__pycache__'}

    # Sandboxed Bash cannot read the host install, so runs use a copy.
    shutil.copytree(sys.base_prefix, target, symlinks=True, ignore=ignore)
    python = target / 'bin/python3'
    if not python.exists():
        raise Failure(f'copied interpreter has no bin/python3 (base prefix {sys.base_prefix})')
    return python


def copy_plugin(source, target):
    source = Path(source).resolve()
    if not (source / '.claude-plugin/plugin.json').is_file():
        raise Failure(f'not a plugin (missing .claude-plugin/plugin.json): {source}')
    links = [path for path in source.rglob('*') if path.is_symlink()]
    if links:
        raise Failure(f'plugin contains symlinks: {links[0].relative_to(source)}')
    shutil.copytree(source, target)


def write_stub(target):
    manifest = target / '.claude-plugin/plugin.json'
    manifest.parent.mkdir(parents=True)
    manifest.write_text(json.dumps(STUB_MANIFEST, indent=2) + '\n')


def prompt_line(arm, invoke):
    if arm == 'plain':
        return CANONICAL_PROMPT
    if arm == 'doctor':
        return PROMPT_KEY + '/doctor'
    # A JSON string is a valid YAML double-quoted scalar.
    return PROMPT_KEY + json.dumps(invoke)


def copy_suite(suite, target, arm, invoke, web_fetch=False):
    shutil.copytree(suite, target, ignore=lambda directory, names: {
        name for name in names
        if name == '__pycache__' or (Path(directory) == suite and name == 'results')})
    cases = sorted(target.glob('cases/*/case.yaml'))
    if not cases:
        raise Failure(f'no cases found under {suite}/cases')
    replacement = prompt_line(arm, invoke)
    for case in cases:
        lines = case.read_text().split('\n')
        hits = [index for index, line in enumerate(lines) if line == CANONICAL_PROMPT]
        if len(hits) != 1:
            raise Failure(f'{case.parent.name}/case.yaml: expected the canonical prompt line exactly once, found {len(hits)}')
        lines[hits[0]] = replacement
        if web_fetch:
            tools = [index for index, line in enumerate(lines) if line == TOOLS_LINE]
            if len(tools) != 1:
                raise Failure(f'{case.parent.name}/case.yaml: expected the allowed_tools line exactly once, found {len(tools)}')
            lines[tools[0]] = TOOLS_LINE[:-1] + ', WebFetch]'
        case.write_text('\n'.join(lines))
    return [case.parent.name for case in cases]


def default_output(arm):
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    return SUITE / 'results' / f'{stamp}-{arm}'


def eval_command(plugin, args, out):
    # --keep-temp keeps each run's trace so its final report can be retained; run() removes the sandboxes.
    command = ['claude', 'plugin', 'eval', str(plugin), '--model', args.model, '--judge-model', args.judge_model,
               '--max-cost-usd', str(args.max_cost_usd), '--runs', str(args.runs), '--trust-plugin', '--scaffold',
               '--no-publish', '--ablation', 'none', '--threshold', '0', '--keep-temp', '--allow-tools', 'Bash']
    if args.web_fetch:
        # --allow-tools is variadic; the next token below is an option, so parsing stops there.
        command.append(WEB_FETCH_RULE)
    command += ['--json', str(out / 'result.json'), '--output-dir', str(out)]
    if args.case:
        command += ['--case', args.case]
    return command


def run(args):
    if args.arm not in PLUGIN_ARMS and args.plugin:
        raise Failure('--plugin applies only to the claudit and claudit-deep arms')
    if args.arm in HEADLESS_ARMS:
        return run_combined(args)
    if args.max_budget_usd is not None:
        raise Failure('--max-budget-usd applies only to the doctor-combined and claudit-deep arms (claude plugin eval '
                      'has no per-run cap)')
    suite = SUITE.resolve()
    out = Path(args.output_dir).resolve() if args.output_dir else default_output(args.arm)
    scratch = Path(tempfile.mkdtemp(prefix='claudit-eval-')).resolve()
    keep = args.keep_scratch
    try:
        plugin = scratch / 'plugin'
        if args.arm == 'claudit':
            copy_plugin(args.plugin or DEFAULT_PLUGIN, plugin)
            if (plugin / 'evals').exists():
                shutil.rmtree(plugin / 'evals')
                print("Notice: the plugin's bundled evals/ were replaced by the Claudit suite and not used.")
        else:
            write_stub(plugin)
        # Sandboxed Bash can read the plugin under test, not its siblings, so the interpreter goes inside it.
        python = copy_python(plugin / '.eval-python')
        path = f'{python.parent}{os.pathsep}{os.environ.get("PATH", "")}'
        cases = copy_suite(suite, plugin / 'evals', args.arm, args.invoke, args.web_fetch)
        if args.case and not any(fnmatch.fnmatchcase(name, args.case) for name in cases):
            print(f'Warning: --case {args.case!r} matches none of: {", ".join(cases)}', file=sys.stderr)
        command = eval_command(plugin, args, out)
        invocation = shlex.join([sys.argv[0], *sys.argv[1:]])
        print(f'Scratch: {scratch}')
        print(f'Command: {shlex.join(command)}')
        if args.dry_run:
            keep = True
            return 0
        out.mkdir(parents=True, exist_ok=True)
        # The exact command lines, for the retained gate record.
        (out / 'command.txt').write_text(f'runner: {invocation}\ncwd: {Path.cwd()}\neval: {shlex.join(command)}\n'
                                         f'eval cwd: {scratch}\n')
        code = subprocess.run(command, cwd=scratch, stdin=subprocess.DEVNULL, env=dict(claude_env(), PATH=path)).returncode
        result = out / 'result.json'
        if result.is_file():
            data = load_result(result)
            data['webFetch'] = args.web_fetch
            result.write_text(json.dumps(data, indent=2) + '\n')
            missing = keep_reports(data, out, args.keep_temp)
            if missing:
                print(f'Warning: no final report text for {", ".join(missing)}', file=sys.stderr)
            summary = summarize_files([result], args.arm, args.model, args.judge_model, args.web_fetch)
            (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
            print(markdown(summary))
            print(f'Summary: {out / "summary.json"}')
        else:
            print(f'No result.json was written to {out}', file=sys.stderr)
            code = code or 1
        if code == 2:
            print('Cost ceiling reached (--max-cost-usd): the eval stopped early and its results are PARTIAL.',
                  file=sys.stderr)
        elif code:
            print(f'claude plugin eval exited with status {code}', file=sys.stderr)
        return code
    finally:
        if not keep:
            shutil.rmtree(scratch, ignore_errors=True)


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


def mean(total, count):
    return round(total / count, 6) if count else 0


def defined_graders(case, runs):
    names = [grader.get('name') for grader in case.get('graders') or [] if isinstance(grader, dict)]
    names = [str(name) for name in names if name]
    if not names:
        names = sorted({str(grader.get('name', '')) for item in runs for grader in item.get('graders') or []})
    return names


def false_defects(failed):
    # Targeted failures are distinct defects; a lone catch-all failure is one more. A lower bound.
    targeted = len(failed - {'no-invented-defects'})
    return targeted or int('no-invented-defects' in failed)


def case_summary(case):
    runs = case.get('arms', {}).get('with', []) or []
    names = defined_graders(case, runs)
    findings = {name for name in names if name.startswith('finding-')}
    structure = {name for name in names if name.startswith('structure-')}
    row = {'case': case.get('name'), 'runs': len(runs), 'findings_hit': 0,
           'findings_total': len(findings) * len(runs), 'structure_passed': 0,
           'structure_total': len(structure) * len(runs), 'false_defects': 0, 'false_defect_runs': 0,
           'agent_cost_usd': 0.0, 'judge_cost_usd': 0.0, 'wall_seconds': 0.0, 'errors': 0, 'skipped_paid_graders': 0}
    for item in runs:
        row['agent_cost_usd'] += number(item.get('costUsd'))
        row['judge_cost_usd'] += number(item.get('judgeCostUsd'))
        row['wall_seconds'] += number(item.get('durationSeconds'))
        row['errors'] += bool(item.get('error'))
        skipped = item.get('skippedPaidGraders')
        row['skipped_paid_graders'] += len(skipped) if isinstance(skipped, list) else number(skipped)
        # Unscored graders stay in the denominator as misses; they are also counted in skipped_paid_graders.
        passed = {str(grader.get('name', '')) for grader in item.get('graders') or []
                  if grader.get('scored') is not False and grader.get('passed') is True}
        failed = {str(grader.get('name', '')) for grader in item.get('graders') or []
                  if grader.get('scored') is not False and grader.get('passed') is not True
                  and str(grader.get('name', '')).startswith('no-invented-')}
        row['findings_hit'] += len(findings & passed)
        row['structure_passed'] += len(structure & passed)
        row['false_defects'] += false_defects(failed)
        row['false_defect_runs'] += bool(failed)
        # doctor-combined: each headless call's cost and wall time.
        for part in item.get('parts') or []:
            total = row.setdefault('parts', {}).setdefault(str(part.get('prompt')), {'cost_usd': 0.0, 'wall_seconds': 0.0})
            total['cost_usd'] = round(total['cost_usd'] + number(part.get('costUsd')), 6)
            total['wall_seconds'] = round(total['wall_seconds'] + number(part.get('durationSeconds')), 1)
    return finish(row)


def finish(row):
    row['hit_rate'] = round(row['findings_hit'] / row['findings_total'], 4) if row['findings_total'] else None
    for key in ('agent_cost_usd', 'judge_cost_usd', 'wall_seconds'):
        row[key] = round(row[key], 6)
        row[key + '_mean'] = mean(row[key], row['runs'])
    return row


def identity(result):
    suite = result.get('suite') if isinstance(result.get('suite'), dict) else {}
    plugins = suite.get('plugins') if isinstance(suite.get('plugins'), list) else []
    return {'claude_version': result.get('claudeVersion'),
            'model': suite.get('modelOverride') or result.get('model') or suite.get('model'),
            'judge_model': suite.get('judgeModel') or result.get('judgeModel'),
            'web_fetch': result.get('webFetch'),
            'plugins': sorted(f"{item.get('name')}@{item.get('version')}" for item in plugins
                              if isinstance(item, dict))}


def summarize(result, arm=None, model=None, judge_model=None, web_fetch=None):
    ident = identity(result)
    if web_fetch is not None and ident['web_fetch'] is not None and web_fetch != ident['web_fetch']:
        raise Failure(f"web_fetch {web_fetch!r} does not match the result ({ident['web_fetch']!r})")
    if web_fetch is not None:
        ident['web_fetch'] = web_fetch
    for key, given in (('model', model), ('judge_model', judge_model)):
        if given and ident[key] and given != ident[key]:
            raise Failure(f'{key} {given!r} does not match the result ({ident[key]!r})')
        ident[key] = ident[key] or given
    rows = [case_summary(case) for case in result.get('cases', []) or []]
    totals = {'case': 'TOTAL'}
    for row in rows:
        for prompt, part in row.get('parts', {}).items():
            total = totals.setdefault('parts', {}).setdefault(prompt, {'cost_usd': 0.0, 'wall_seconds': 0.0})
            total['cost_usd'] = round(total['cost_usd'] + part['cost_usd'], 6)
            total['wall_seconds'] = round(total['wall_seconds'] + part['wall_seconds'], 1)
    for key in ('runs', 'findings_hit', 'findings_total', 'structure_passed', 'structure_total', 'false_defects',
                'false_defect_runs', 'agent_cost_usd', 'judge_cost_usd', 'wall_seconds', 'errors',
                'skipped_paid_graders'):
        totals[key] = sum(row[key] for row in rows)
    totals = finish(totals)
    return {'arm': arm, **ident,
            'total_cost_usd': result.get('costUsd'),
            'agent_plus_judge_cost_usd': round(totals['agent_cost_usd'] + totals['judge_cost_usd'], 6),
            'duration_seconds': result.get('durationSeconds'),
            'partial': result.get('partial'),
            'cases': rows, 'totals': totals}


def load_result(path):
    try:
        result = json.loads(Path(path).read_text())
    except (OSError, ValueError) as exc:
        raise Failure(f'cannot read eval result {path}: {exc}') from exc
    if not isinstance(result, dict):
        raise Failure(f'eval result is not a JSON object: {path}')
    return result


def merge_results(results):
    """Combine passes of one arm: runs of a case with the same name are pooled."""
    if len(results) == 1:
        return results[0]
    idents = [identity(result) for result in results]
    for key in ('model', 'judge_model', 'claude_version', 'web_fetch', 'plugins'):
        values = {json.dumps(ident[key]) for ident in idents}
        if len(values) > 1:
            raise Failure(f'cannot pool results with different {key}: {", ".join(sorted(values))}')
    merged = {key: results[0].get(key) for key in ('claudeVersion', 'model', 'judgeModel', 'suite', 'webFetch')}
    merged.update(costUsd=round(sum(number(result.get('costUsd')) for result in results), 6),
                  durationSeconds=sum(number(result.get('durationSeconds')) for result in results),
                  partial=any(result.get('partial') for result in results), cases=[])
    cases = {}
    for result in results:
        for case in result.get('cases', []) or []:
            if case.get('name') not in cases:
                cases[case.get('name')] = {'name': case.get('name'), 'graders': case.get('graders') or [],
                                           'arms': {'with': []}}
                merged['cases'].append(cases[case.get('name')])
            cases[case.get('name')]['arms']['with'] += case.get('arms', {}).get('with', []) or []
    return merged


def summarize_files(paths, arm=None, model=None, judge_model=None, web_fetch=None):
    return summarize(merge_results([load_result(path) for path in paths]), arm, model, judge_model, web_fetch)


def markdown(summary):
    def cost(value):
        return f'{value:.4f}'

    header = ('| Case | Runs | Findings | Hit rate | Structure | False defects (runs) | Agent $ (mean) '
              '| Judge $ (mean) '
              '| Wall s (mean) | Errors | Skipped paid |')
    lines = [f"Arm: {summary['arm'] or '-'} | model: {summary['model'] or '-'} | judge: {summary['judge_model'] or '-'} "
             f"| web fetch: {'on' if summary['web_fetch'] else 'off' if summary['web_fetch'] is False else '-'} "
             f"| plugins: {', '.join(summary['plugins']) or '-'} | claude {summary['claude_version'] or '-'} | total ${summary['total_cost_usd']} "
             f"(agent+judge ${summary['agent_plus_judge_cost_usd']}) | partial: {summary['partial']}",
             '', header, '|' + '---|' * (header.count('|') - 1)]
    for row in [*summary['cases'], summary['totals']]:
        rate = '-' if row['hit_rate'] is None else f"{row['hit_rate']:.0%}"
        lines.append(f"| {row['case']} | {row['runs']} | {row['findings_hit']}/{row['findings_total']} | {rate} "
                     f"| {row['structure_passed']}/{row['structure_total']} | {row['false_defects']} ({row['false_defect_runs']}) "
                     f"| {cost(row['agent_cost_usd'])} ({cost(row['agent_cost_usd_mean'])}) "
                     f"| {cost(row['judge_cost_usd'])} ({cost(row['judge_cost_usd_mean'])}) "
                     f"| {row['wall_seconds']:.1f} ({row['wall_seconds_mean']:.1f}) | {row['errors']} "
                     f"| {row['skipped_paid_graders']} |")
    for prompt, part in summary['totals'].get('parts', {}).items():
        lines.append(f"\n`{prompt}`: agent ${cost(part['cost_usd'])}, {part['wall_seconds']:.1f} s in total")
    return '\n'.join(lines)


def load_helper(plugin):
    """The candidate's scan helper as a module, for its test-data rule."""
    path = Path(plugin) / HELPER
    loader = importlib.machinery.SourceFileLoader('claudit_helper', str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader('claudit_helper', loader))
    sys.dont_write_bytecode = True  # never leave a cache in the plugin bytes
    loader.exec_module(module)
    return module


def grade_report(text, scan, helper):
    """Script checks of one report against the scan of the same tree: {check: passed}."""
    def letter(name):
        match = re.search(r'\*\*%s: ([A-F])\*\*' % name, text)
        return match.group(1) if match else None

    titles = [item['title'] for item in scan['plan']['items']]
    checks = {'plan_items': re.search(plan_items_pattern(titles), text, re.I) is not None,
              'grades': all(letter(name.capitalize()) == grade['letter'] for name, grade in scan['grades'].items()),
              'grade_raise': re.search(GRADE_RAISE, text, re.I) is None,
              'footer': scan['footer'] in text,
              # A self-check of the scan, not of the report: it raised nothing on test data.
              'scan_no_test_data_findings': not any(helper.data_path(f['path']) for f in scan['findings'])}
    top = re.search(TOP + r'((?:(?!\n#{1,2}[ \t]|\n[-*_]{3,}[ \t]*(?:\n|(?![\s\S])))[\s\S])*)', text, re.I)
    checks['optional_not_planned'] = bool(top) and not any(
        entry['path'] in top.group(1) for entry in scan.get('optional', []))
    if scan.get('declined'):
        refs = ['%s:%d' % (entry['path'], entry['line']) for entry in scan['declined']]
        checks['declined_listed'] = re.search(declined_pattern(refs), text) is not None
        checks['declined_reasons'] = re.search(declined_cues(reason_cue(e) for e in scan['declined']), text,
                                               re.I) is not None
        checks['reconsider_notes'] = all(
            re.search(declined_cues([reconsider_cue(e)]), text, re.I) if e.get('reconsider')
            else not re.search(declined_cues([no_reconsider_cue(e)]), text, re.I) for e in scan['declined'])
        if not any(e.get('reconsider') for e in scan['declined']):
            checks['reconsider_notes'] = checks['reconsider_notes'] and not re.search(RECONSIDER_FREE, text, re.I)
        cited = [(n, item) for n, item in enumerate(scan['plan']['items'], 1) if item.get('declined')]
        if cited:
            checks['declined_defects_cited'] = all(re.search(defect_cited_pattern(n, item), text, re.I)
                                                   for n, item in cited)
    return checks


def final_reply(trace):
    """Claude's final reply in a run trace (one JSON message per line), or None."""
    result = reply = None
    for line in Path(trace).read_text(errors='replace').splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if not isinstance(message, dict):
            continue
        if message.get('type') == 'result' and isinstance(message.get('result'), str):
            result = message['result']
        body = message.get('message') if isinstance(message.get('message'), dict) else message
        if message.get('type') == 'assistant' or body.get('role') == 'assistant':
            content = body.get('content')
            if isinstance(content, list):
                content = '\n'.join(block.get('text', '') for block in content
                                    if isinstance(block, dict) and block.get('type') == 'text')
            if isinstance(content, str) and content.strip():
                reply = content
    return result if result and result.strip() else reply


def remove_sandbox(path):
    """Remove a kept eval sandbox. claude plugin eval leaves some directories unreadable (`sealed`), so make each
    directory the operator's own writable one first. Returns False when it can't be removed."""
    for directory, subdirs, _ in os.walk(path):
        for name in subdirs:
            child = os.path.join(directory, name)
            if not os.path.islink(child):
                os.chmod(child, 0o700)
    try:
        shutil.rmtree(path)
    except OSError:
        return False
    return True


def keep_reports(result, out, keep_temp):
    """Write each run's final reply to <out>/reports/<case>-run<N>.md; drop the kept sandboxes unless asked."""
    reports, missing, stuck = out / 'reports', [], []
    for case in result.get('cases', []) or []:
        for number, item in enumerate(case.get('arms', {}).get('with', []) or [], 1):
            name = f"{case.get('name')}-run{number}.md"
            trace = Path(str(item.get('tracePath') or ''))
            text = final_reply(trace) if trace.is_file() else None
            if text is None:
                missing.append(name)
            else:
                reports.mkdir(exist_ok=True)
                (reports / name).write_text(text if text.endswith('\n') else text + '\n')
            sandbox = trace.parent.parent
            # claude plugin eval --keep-temp leaves <tmp>/e-XXXXXX/out/trace.jsonl; remove only that shape.
            if not keep_temp and trace.parent.name == 'out' and re.fullmatch(r'e-[A-Za-z0-9]{6}', sandbox.name) \
                    and sandbox.is_dir() and not sandbox.is_symlink():
                os.chmod(sandbox, 0o700)
                if not remove_sandbox(sandbox):
                    stuck.append(str(sandbox))
    if stuck:
        print(f'Warning: could not remove eval sandboxes: {", ".join(stuck)}', file=sys.stderr)
    return missing


def claude_env():
    # A background marketplace refresh would rewrite the operator's ~/.claude/plugins/*.json mid-run (#187).
    return dict(os.environ, DISABLE_AUTOUPDATER='1')


def refuse_instructions_above(path, what):
    """An instruction file above `path` would load into a headless run: remove `path` and refuse."""
    for parent in Path(path).parents:
        found = [name for name in INSTRUCTION_FILES if (parent / name).is_file()]
        if found:
            shutil.rmtree(path, ignore_errors=True)
            raise Failure(f'{parent / found[0]} is above {what} and would load; set TMPDIR elsewhere')


def claude_call(prompt, cwd, flags, model, budget, stdin_prompt=False, env=None):
    """One `claude -p` call: (command, parsed JSON or {}, stdout, stderr, exit status, wall seconds)."""
    command = ['claude', '-p', *([] if stdin_prompt else [prompt]), *flags, '--model', model,
               '--max-budget-usd', str(budget)]
    started = time.monotonic()
    try:
        proc = subprocess.run(command, cwd=cwd, capture_output=True, text=True, env=dict(claude_env(), **(env or {})),
                              timeout=CALL_TIMEOUT,
                              input=prompt if stdin_prompt else None,
                              stdin=None if stdin_prompt else subprocess.DEVNULL)
        stdout, stderr, code = proc.stdout, proc.stderr, proc.returncode
    except subprocess.TimeoutExpired as exc:
        stdout, stderr, code = exc.stdout or '', (exc.stderr or '') + f'\ntimed out after {CALL_TIMEOUT} s', -1
        stdout, stderr = (x.decode(errors='replace') if isinstance(x, bytes) else x for x in (stdout, stderr))
    wall = time.monotonic() - started
    try:
        raw = json.loads(stdout)
    except ValueError:
        raw = {}
    return command, raw if isinstance(raw, dict) else {}, stdout, stderr, code, wall


def doctor_combined(workspace, model, budget, record):
    """`/doctor` then `/doctor prompt-audit .` in a workspace, read-only: (report, parts). `record(stem, stdout,
    stderr)` keeps each call's raw output."""
    texts, parts = [], []
    for prompt in DOCTOR_PROMPTS:
        command, raw, stdout, stderr, code, wall = claude_call(prompt, workspace, DOCTOR_FLAGS, model, budget)
        record('prompt-audit' if 'prompt-audit' in prompt else 'doctor', stdout, stderr)
        text = raw.get('result') if isinstance(raw.get('result'), str) else ''
        denials = raw.get('permission_denials')
        parts.append({'prompt': prompt, 'command': shlex.join(command), 'exit': code,
                      'costUsd': number(raw.get('total_cost_usd')), 'durationSeconds': round(wall, 1),
                      'isError': bool(raw.get('is_error')) or code != 0 or not text.strip(),
                      'permissionDenials': len(denials) if isinstance(denials, list) else 0})
        texts.append(f'# {prompt}\n\n{text.strip()}\n')
    return '\n'.join(texts), parts


def nested_calls(path):
    """The nested prompt-audit calls the helper recorded: [{status, cost_usd, seconds, permission_denials}]."""
    try:
        lines = Path(path).read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return [c for c in out if isinstance(c, dict)]


def deep_flags(plugin):
    return ('--plugin-dir', str(plugin), *HEADLESS_FLAGS)


def claudit_deep(workspace, args, record, log):
    """Claudit --deep in a workspace, headless: (report, parts). The one part's cost and time include the nested
    prompt-audit call the helper recorded in `log`."""
    prompt = args.invoke if args.invoke != DEFAULT_INVOKE else DEEP_INVOKE
    plugin = Path(args.plugin or DEFAULT_PLUGIN).resolve()
    command, raw, stdout, stderr, code, wall = claude_call(prompt, workspace, deep_flags(plugin), args.model,
                                                           args.max_budget_usd,
                                                           env={DEEP_RECORD: str(log), DEEP_MODEL: args.model})
    record('claudit-deep', stdout, stderr)
    nested = nested_calls(log)
    text = raw.get('result') if isinstance(raw.get('result'), str) else ''
    denials = raw.get('permission_denials')
    outer = number(raw.get('total_cost_usd'))
    part = {'prompt': prompt, 'command': shlex.join(command), 'exit': code,
            'costUsd': round(outer + sum(number(c.get('cost_usd')) for c in nested), 6), 'agentCostUsd': outer,
            'durationSeconds': round(wall, 1), 'isError': bool(raw.get('is_error')) or code != 0 or not text.strip(),
            'permissionDenials': len(denials) if isinstance(denials, list) else 0,
            'nested': [{k: c.get(k) for k in NESTED_FIELDS} for c in nested]}
    return text, [part]


def read_grader(path):
    """A grader file's frontmatter fields and its body (the criterion an llm grader sends the judge)."""
    text = Path(path).read_text()
    if not text.startswith('---\n') or '\n---\n' not in text[3:]:
        raise Failure(f'{path}: no frontmatter')
    head, body = text[4:].split('\n---\n', 1)
    fields = {}
    for line in head.splitlines():
        key, _, value = line.partition(': ')
        if len(value) > 1 and value[0] == value[-1] == "'":
            value = value[1:-1].replace("''", "'")
        fields[key.strip()] = value
    fields['criteria'] = body.strip()
    fields['name'] = Path(path).stem
    return fields


def judge_output(text):
    """The judge sees at most 100,000 characters: the first 80,000 and the last 20,000, as the eval host elides."""
    head, tail = 80000, 20000
    if len(text) <= head + tail:
        return text
    return text[:head] + f'\n[…{len(text) - head - tail} chars elided…]\n' + text[-tail:]


def grade_with_graders(text, graders, judge, workdir):
    """Grade a report with a case's graders: regex graders in Python's re (the suite's patterns behave the same in
    JavaScript, which tests check), llm graders with the eval host's judge prompt. Returns (results, judge cost)."""
    results, cost = [], 0.0
    for grader in graders:
        if grader.get('type') == 'regex':
            found = re.search(grader['pattern'], text, re.I if 'i' in grader.get('flags', '') else 0) is not None
            passed = found != (grader.get('match') == 'not_contains')
            results.append({'name': grader['name'], 'type': 'regex', 'passed': passed, 'scored': True})
        elif grader.get('type') == 'llm':
            prompt = JUDGE_PROMPT.format(criteria=grader['criteria'], output=judge_output(text))
            votes = []
            for _ in range(JUDGE_VOTES):
                _, raw, _, _, code, _ = claude_call(prompt, workdir, JUDGE_FLAGS, judge['model'], judge['budget'],
                                                    stdin_prompt=True)
                cost += number(raw.get('total_cost_usd'))
                reply = raw.get('result') if isinstance(raw.get('result'), str) and code == 0 else ''
                votes.append(bool(re.search(r'\bPASS\b', reply, re.I)) and not re.search(r'\bFAIL\b', reply, re.I))
            results.append({'name': grader['name'], 'type': 'llm', 'passed': sum(votes) > len(votes) / 2,
                            'scored': True, 'judgeVotes': votes,
                            'explanation': 'judge votes: ' + ' '.join('PASS' if v else 'FAIL' for v in votes)})
        else:
            results.append({'name': grader['name'], 'type': grader.get('type'), 'passed': False, 'scored': False})
    return results, round(cost, 6)


def combined_case_run(case, number, args, out, judge):
    """One doctor-combined run of one case in a fresh scaffolded workspace: the run record for result.json."""
    graders = [read_grader(path) for path in sorted((case / 'graders').glob('*.md'))]
    scratch = Path(tempfile.mkdtemp(prefix='claudit-combined-')).resolve()
    try:
        # The eval host's layout: the workspace's parent is the run's home, where f17-scope writes its parent files.
        workspace = scratch / 'home' / 'cwd'
        workspace.mkdir(parents=True)
        refuse_instructions_above(scratch, 'the workspace')
        scaffold = subprocess.run(['bash', str(case / 'scaffold.sh')], cwd=workspace, capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL,
                                  env=dict(os.environ, GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull))
        if scaffold.returncode:
            return {'error': f'scaffold failed: {scaffold.stderr.strip()}', 'costUsd': 0, 'judgeCostUsd': 0,
                    'durationSeconds': 0, 'graders': [], 'parts': []}
        calls = out / 'calls'
        calls.mkdir(exist_ok=True)

        def record(stem, stdout, stderr):
            (calls / f'{case.name}-run{number}-{stem}.json').write_text(stdout)
            (calls / f'{case.name}-run{number}-{stem}.stderr.txt').write_text(stderr)

        if args.arm == 'claudit-deep':
            report, parts = claudit_deep(workspace, args, record, scratch / 'deep-record.jsonl')
        else:
            report, parts = doctor_combined(workspace, args.model, args.max_budget_usd, record)
        judge_dir = scratch / 'judge'
        judge_dir.mkdir()
        results, judge_cost = grade_with_graders(report, graders, judge, judge_dir)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    reports = out / 'reports'
    reports.mkdir(exist_ok=True)
    (reports / f'{case.name}-run{number}.md').write_text(report)
    failed = [part['prompt'] for part in parts if part['isError']]
    return {'costUsd': round(sum(part['costUsd'] for part in parts), 6), 'judgeCostUsd': judge_cost,
            'durationSeconds': round(sum(part['durationSeconds'] for part in parts), 1),
            'error': f'no usable reply from {", ".join(failed)}' if failed else None,
            'graders': results, 'parts': [{k: v for k, v in part.items() if k != 'command'} for part in parts]}


def run_combined(args):
    """A headless arm (doctor-combined or claudit-deep) over the suite: a result.json in the shape `claude plugin
    eval` writes."""
    cases = sorted(path.parent for path in SUITE.glob('cases/*/case.yaml'))
    if args.case:
        cases = [case for case in cases if fnmatch.fnmatchcase(case.name, args.case)]
    if not cases:
        raise Failure(f'no case matches {args.case!r}')
    if args.max_budget_usd is None:
        raise Failure('--max-budget-usd (per headless call) is required for the %s arm' % args.arm)
    out = Path(args.output_dir).resolve() if args.output_dir else default_output(args.arm)
    jobs = [(case, n) for case in cases for n in range(1, args.runs + 1)]
    judge = {'model': args.judge_model, 'budget': args.judge_budget_usd}
    if args.arm == 'claudit-deep':
        plugin = Path(args.plugin or DEFAULT_PLUGIN).resolve()
        if not (plugin / '.claude-plugin/plugin.json').is_file():
            raise Failure(f'not a plugin (missing .claude-plugin/plugin.json): {plugin}')
        calls = [(args.invoke if args.invoke != DEFAULT_INVOKE else DEEP_INVOKE, deep_flags(plugin))]
    else:
        calls = [(prompt, DOCTOR_FLAGS) for prompt in DOCTOR_PROMPTS]
    lines = [shlex.join(['claude', '-p', prompt, *flags, '--model', args.model, '--max-budget-usd',
                         str(args.max_budget_usd)]) for prompt, flags in calls]
    print(f'Cases: {", ".join(case.name for case in cases)} x {args.runs} run(s)')
    print('Command: ' + lines[0])
    if args.dry_run:
        return 0
    out.mkdir(parents=True, exist_ok=True)
    (out / 'command.txt').write_text(
        f'runner: {shlex.join([sys.argv[0], *sys.argv[1:]])}\ncwd: {Path.cwd()}\n' + ''.join(
            'headless: ' + line + '\n' for line in lines)
        + 'judge: ' + shlex.join(['claude', '-p', *JUDGE_FLAGS, '--model', args.judge_model, '--max-budget-usd',
                                  str(args.judge_budget_usd)]) + ' < prompt\n'
        + 'headless cwd: <tmp>/claudit-combined-XXXX/home/cwd (a fresh scaffold per run)\n'
        + ('nested: claudit.py deep runs claude -p "/doctor prompt-audit ." with the doctor-combined flags plus Bash and '
           'Skill(claudit:claudit) denied, --model %s (%s=%s) and --max-budget-usd 0.5 (SKILL.md step 1)\n'
           % (args.model, DEEP_MODEL, args.model) if args.arm == 'claudit-deep' else ''))
    version = subprocess.run(['claude', '--version'], capture_output=True, text=True, env=claude_env()).stdout.strip()
    lock, spent, partial, runs = threading.Lock(), [0.0], [False], {}
    started = time.monotonic()

    def work(job):
        with lock:
            if spent[0] >= args.max_cost_usd:
                partial[0] = True
                return job, None
        item = combined_case_run(*job, args, out, judge)
        with lock:
            spent[0] += item['costUsd'] + item['judgeCostUsd']
            print(f"{job[0].name} run{job[1]}: ${item['costUsd'] + item['judgeCostUsd']:.4f} "
                  f"({item['durationSeconds']:.0f} s), cumulative ${spent[0]:.4f}"
                  + (f", ERROR {item['error']}" if item['error'] else ''), flush=True)
        return job, item

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.concurrency) as pool:
        for job, item in pool.map(work, jobs):
            if item is not None:
                runs.setdefault(job[0].name, []).append(item)
    result = {'claudeVersion': version.split(' ')[0] if version else None, 'model': args.model,
              'judgeModel': args.judge_model, 'arm': args.arm, 'webFetch': False,
              'suite': {'modelOverride': args.model, 'judgeModel': args.judge_model, 'plugins': []},
              'costUsd': round(spent[0], 6), 'durationSeconds': round(time.monotonic() - started, 1),
              'partial': partial[0],
              'cases': [{'name': case.name,
                         'graders': [{'name': g['name'], 'type': g.get('type')} for g in
                                     (read_grader(path) for path in sorted((case / 'graders').glob('*.md')))],
                         'arms': {'with': runs.get(case.name, [])}} for case in cases]}
    (out / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
    summary = summarize(result, args.arm, args.model, args.judge_model, False)
    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(markdown(summary))
    print(f'Summary: {out / "summary.json"}')
    if partial[0]:
        print('Cost ceiling reached (--max-cost-usd): runs were skipped and the results are PARTIAL.', file=sys.stderr)
        return 2
    return 0


def headless_combined(args, out):
    """Fresh-clone doctor-combined reports of one repository at one commit; kept, not script-graded."""
    version = subprocess.run(['claude', '--version'], capture_output=True, text=True, env=claude_env()).stdout.strip()
    runs = []
    for number in range(1, args.runs + 1):
        work = Path(tempfile.mkdtemp(prefix='claudit-headless-')).resolve()
        refuse_instructions_above(work, 'the clone')
        run_dir = out / f'run{number}'
        run_dir.mkdir(exist_ok=True)
        try:
            clone = work / 'repo'
            subprocess.run(['git', 'clone', '--quiet', args.repo, str(clone)], check=True)
            subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '--detach', args.sha], check=True)
            head = subprocess.run(['git', '-C', str(clone), 'rev-parse', 'HEAD'], capture_output=True, text=True,
                                  check=True).stdout.strip()
            started = dt.datetime.now(dt.timezone.utc)

            def record(stem, stdout, stderr):
                (run_dir / f'{stem}.json').write_text(stdout)
                (run_dir / f'{stem}.stderr.txt').write_text(stderr)

            report, parts = doctor_combined(clone, args.model, args.max_budget_usd, record)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        (run_dir / 'report.md').write_text(report)
        meta = {'arm': 'doctor-combined', 'cwd': 'fresh clone of the repository', 'repo': args.repo, 'sha': args.sha,
                'head': head, 'claude': version, 'model': args.model, 'started': started.strftime('%Y-%m-%dT%H:%M:%SZ'),
                'parts': parts, 'cost_usd': round(sum(part['costUsd'] for part in parts), 6),
                'wall_seconds': round(sum(part['durationSeconds'] for part in parts), 1),
                'passed': not any(part['isError'] for part in parts)}
        (run_dir / 'meta.json').write_text(json.dumps(meta, indent=2) + '\n')
        runs.append(meta)
        print(f"run{number}: ${meta['cost_usd']}, {meta['wall_seconds']:.0f} s, "
              f"{'ok' if meta['passed'] else 'ERROR'} {[(p['prompt'], p['exit'], p['costUsd']) for p in parts]}")
    summary = {'repo': args.repo, 'sha': args.sha, 'arm': 'doctor-combined', 'runs': len(runs),
               'passed': sum(r['passed'] for r in runs),
               'median_cost_usd': statistics.median(r['cost_usd'] for r in runs),
               'median_wall_seconds': statistics.median(r['wall_seconds'] for r in runs),
               'total_cost_usd': round(sum(r['cost_usd'] for r in runs), 6)}
    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(json.dumps(summary))
    return 0 if summary['passed'] == len(runs) else 1


def headless(args):
    """Fresh-clone read-only audits of one repository at one commit, each recorded and script-graded."""
    if args.arm == 'doctor-combined':
        if args.plugin:
            raise Failure('--plugin applies only to the claudit arm')
        out = Path(args.output_dir).resolve()
        out.mkdir(parents=True, exist_ok=True)
        return headless_combined(args, out)
    if not args.plugin:
        raise Failure('--plugin is required for the claudit arm')
    plugin = Path(args.plugin).resolve()
    if not (plugin / '.claude-plugin/plugin.json').is_file():
        raise Failure(f'not a plugin (missing .claude-plugin/plugin.json): {plugin}')
    helper = load_helper(plugin)
    out = Path(args.output_dir).resolve()
    out.mkdir(parents=True, exist_ok=True)
    version = subprocess.run(['claude', '--version'], capture_output=True, text=True, env=claude_env()).stdout.strip()
    runs = []
    for number in range(1, args.runs + 1):
        work = Path(tempfile.mkdtemp(prefix='claudit-headless-')).resolve()
        refuse_instructions_above(work, 'the clone')  # it would load into the audit
        try:
            clone = work / 'repo'
            subprocess.run(['git', 'clone', '--quiet', args.repo, str(clone)], check=True)
            subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '--detach', args.sha], check=True)
            head = subprocess.run(['git', '-C', str(clone), 'rev-parse', 'HEAD'], capture_output=True, text=True,
                                  check=True).stdout.strip()
            command = ['claude', '-p', args.invoke, '--plugin-dir', str(plugin), *HEADLESS_FLAGS,
                       '--model', args.model, '--max-budget-usd', str(args.max_budget_usd)]
            started = dt.datetime.now(dt.timezone.utc)
            log = work / 'deep-record.jsonl'  # what a --deep run's nested prompt-audit cost
            proc = subprocess.run(command, cwd=clone, capture_output=True, text=True, stdin=subprocess.DEVNULL,
                                  env=dict(claude_env(), **{DEEP_RECORD: str(log), DEEP_MODEL: args.model}))
            wall = (dt.datetime.now(dt.timezone.utc) - started).total_seconds()
            nested = nested_calls(log)
            scan = subprocess.run([sys.executable, str(plugin / HELPER), 'scan', '--root', str(clone)],
                                  capture_output=True, text=True)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        run_dir = out / f'run{number}'
        run_dir.mkdir(exist_ok=True)
        (run_dir / 'raw.json').write_text(proc.stdout)
        (run_dir / 'stderr.txt').write_text(proc.stderr)
        (run_dir / 'scan.json').write_text(scan.stdout)
        try:
            raw = json.loads(proc.stdout)
        except ValueError:
            raw = {}
        text = raw.get('result') if isinstance(raw.get('result'), str) else ''
        (run_dir / 'report.md').write_text(text)
        checks = grade_report(text, json.loads(scan.stdout), helper) if scan.returncode == 0 and text else {}
        meta = {'command': shlex.join(command), 'cwd': 'fresh clone of the repository', 'repo': args.repo,
                'sha': args.sha, 'head': head, 'plugin': str(plugin), 'claude': version, 'model': args.model,
                'started': started.strftime('%Y-%m-%dT%H:%M:%SZ'), 'wall_seconds': round(wall, 1),
                'exit': proc.returncode, 'agent_cost_usd': raw.get('total_cost_usd'),
                'cost_usd': round(raw['total_cost_usd'] + sum(c.get('cost_usd') or 0 for c in nested), 6)
                if isinstance(raw.get('total_cost_usd'), (int, float)) else None,
                'nested': nested, 'checks': checks,
                'passed': bool(checks) and all(checks.values())}
        (run_dir / 'meta.json').write_text(json.dumps(meta, indent=2) + '\n')
        runs.append(meta)
        print(f"run{number}: exit {proc.returncode}, {wall:.0f} s, ${raw.get('total_cost_usd')}, "
              f"{'pass' if meta['passed'] else 'FAIL'} {checks}")
    costs = [r['cost_usd'] for r in runs if isinstance(r['cost_usd'], (int, float))]
    summary = {'repo': args.repo, 'sha': args.sha, 'runs': len(runs), 'passed': sum(r['passed'] for r in runs),
               'median_cost_usd': statistics.median(costs) if costs else None,
               'median_wall_seconds': statistics.median(r['wall_seconds'] for r in runs),
               'total_cost_usd': round(sum(costs), 6)}
    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(json.dumps(summary))
    return 0 if summary['passed'] == len(runs) else 1


def grade(args):
    scan = json.loads(Path(args.scan).read_text())
    checks = grade_report(Path(args.report).read_text(), scan, load_helper(args.plugin or DEFAULT_PLUGIN))
    print(json.dumps(checks, indent=2))
    return 0 if all(checks.values()) else 1


# Gate graders for #193's fixed rules, run on saved reports at $0 (`gate`). They live outside the case folders so the
# frozen #192 suite and its grader counts don't change. Each matches structure and co-occurrence, not a phrasing.

# Rule 6: no principles skill anywhere in an f19 report, Optional notes and Also worth knowing included.
#
# The unit is one clause of one sentence of a report item. A clause proposes a principles skill when it holds all
# three: (a) a creation act, (b) a target that is a skill, slash command or command, and (c) the principles as its
# source or subject (named, or "it", "them", "that", "the list" after the principles were named earlier in the same
# item). A rejection exempts only its own clause. A later clause with a creation act and "it", "one" or "them" (or an
# act with no object, "worth adding later") proposes when an earlier clause of the item raised a principles skill.
# f19 has no skills, so a named skill counts like any other target; a clause that runs or uses a skill has no
# creation act and proposes nothing.
PRINCIPLES = re.compile(r'\bprinciples?\b|principles\.md', re.I)
TARGET = re.compile(r'\bskills?\b|\bslash[ \t]+commands?\b|\bcommands?\b|\.claude/(?:skills|commands)/|\bSKILL\.md\b|'
                    r'(?:^|[\s`(])/[a-z][\w-]*\b', re.I)
SKILL_WORD = re.compile(r'\bskills?\b|\bslash[ \t]+commands?\b|\.claude/(?:skills|commands)/|\bSKILL\.md\b|'
                        r'(?:^|[\s`(])/principles\b', re.I)  # doc-skills: what names a skill
_VERB = (r'add|create|write|make|turn|convert|package|wrap|capture|extract|move|put|build|give|introduce|define|'
         r'ship|split|promote|extend|bundle|codify|encode|expose|register|recommend|suggest|propose|consider|try|'
         r'set[ \t]+up|spin[ \t]+up|break[ \t]+out')
ACT = re.compile(
    r"\b(?:%s)\b" % '|'.join(v[:-1] + '(?:e|es|ed|ing)' if v.endswith('e') else v + '(?:s|es|ed|ing)?'
                              for v in _VERB.split('|'))
    + r"|\b(?:deserves?|warrants?)\b|\bits[ \t]+own\b|\bnew[ \t]+(?:\S+[ \t]+){0,2}?(?:skills?|(?:slash[ \t]+)?commands?)\b"
    r"|\bworth[ \t]+(?:adding|having|creating|making|writing|turning)\b|\bwhy[ \t]+not\b|\b(?:how|what)[ \t]+about\b"
    r"|\bas[ \t]+an?[ \t]+(?:\S+[ \t]+){0,2}?(?:skills?|(?:slash[ \t]+)?commands?)\b"
    r"|\b(?:would|could|might|should|will|can)(?:n[’']t)?\b[^.;,]{0,60}?\b(?:help|work|cut|load|fit|benefit|save|"
    r"become|be[ \t]+(?:an?[ \t]+)?(?:good|great|useful|better|natural|nice|ideal))\b"
    r"|\bhelps?\b|\bon[ \t]+demand\b"
    r"|(?:\bnot|n[’']t)[ \t]+(?:hesitate|skip|avoid|rule[ \t]+out|leave[ \t]+out|pass[ \t]+on)\b"  # double negation
    r"|(?:\bnot|n[’']t)[ \t]+(?:\w+[ \t]+)?(?:overkill|unnecessary|pointless|redundant|premature)\b", re.I)
NEGATOR = re.compile(r"\b(?:no|none|not|never|nothing|without|avoid|skip|rather than|instead of|against)\b|"
                     r"n[’']t\b", re.I)
# A negation reaches the act or the target when no comma, semicolon, colon or conjunction (and, or, but, then, so)
# and at most eight words sit between them: "No skill is needed", "There is no need to turn the principles into a
# skill". A negation that urges ("Don't hesitate", "wouldn't skip") negates nothing.
SCOPE_BREAK = re.compile(r'[,;:]|\b(?:and|or|but|then|so|yet)\b', re.I)
CANCELS = re.compile(r"[ \t]+(?:\w+[ \t]+)?(?:hesitate|wait|forget|delay|overlook|miss|skip|avoid|rule[ \t]+out|"
                     r"leave[ \t]+out|pass[ \t]+on|overkill|unnecessary|pointless|redundant|premature)\b", re.I)
WHY_NOT = re.compile(r"\bwhy (?:not|don[’']t (?:we|you))\b", re.I)  # a rhetorical proposal, never a negation
# A judgement in the same clause that rejects the skill, unless itself negated: "a skill would be overkill".
REJECTS = re.compile(r"\b(?:overkill|unnecessary|unneeded|pointless|redundant|premature|wrong (?:fit|tool|choice)|"
                     r"(?:poor|bad) fit|no value|add(?:s)? nothing|not (?:needed|worth|necessary|a (?:good )?fit)|"
                     r"(?:is|are)n[’']t (?:needed|worth|necessary|a (?:good )?fit)|decided against|ruled (?:it )?out|"
                     r"rejected|declined|left (?:it )?out|chose not to|would duplicate|duplicates? (?:it|the doc)|"
                     r"(?:leave|keep) (?:it|them) as (?:a |the )?(?:doc|text|prose|is))\b", re.I)
# "Skills are for procedures": a statement of what skills fit, about something other than the principles.
SKILLS_FIT = re.compile(r'\bskills?[ \t]+(?:are[ \t]+for|suit|fit|belong[ \t]+to|work[ \t]+best[ \t]+for)[ \t]+'
                        r'(?:\w+[ \t]+){0,2}(?:procedures?|steps|workflows?|tasks)\b', re.I)
# A clause that runs or uses an existing skill: "Run the `review` skill", "Use the `review` skill when …".
USES = re.compile(r'\b(?:run|use|invoke|call|start|launch)(?:s|es|ed|ing)?\b[ \t]+(?:the[ \t]+)?`?/?[\w:-]+`?[ \t]+'
                  r'(?:skill|slash command)\b', re.I)
REJECT_NEGATED = re.compile(r"\b(?:not|never|n[’']t|hardly)\b[ \t]+(?:\w+[ \t]+){0,2}$", re.I)
# A line that records a decline or a dropped finding, not a proposal: "Declined: a skill for docs/principles.md".
SET_ASIDE = re.compile(r'^\W*(?:Declined|Rejected|Not proposed|Not counted|Dropped|Left out)\b[^:\n]{0,40}:', re.I)
BACK_REFERENCE = re.compile(r'\b(?:it|them|this|that|these|those|the (?:list|doc|file|page))\b', re.I)
POINTS_BACK = re.compile(r"[ \t]*(?:(?:it|one|them|that)\b|(?:(?:later|eventually|someday|today|now|then|again|"
                         r"too|as well|in (?:the )?future)\b[ \t]*)*[.!?]?$)", re.I)
CLAUSE_SPLIT = re.compile(r'[;:]\s+|,\s+(?=(?:but|so|and|then|which|though|although|while|whereas|however|yet)\b)|'
                          r'\s+(?:but|so|then|which|though|although|while|whereas|however)\s+|\s[—–-]\s')
OTHER_MD = re.compile(r'`?([\w./-]+\.md)`?')


def report_units(text):
    """Paragraphs, list items and table rows of a report, each as (first line number, text); a fenced block is
    part of the unit it sits in."""
    units, current, start, fence = [], [], 0, False
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith(('```', '~~~')):
            fence = not fence
            current.append(line)
            continue
        new = not fence and (not stripped or stripped.startswith(('#', '|')) or re.match(r'\s*(?:[-*+]|\d+[.)])\s',
                                                                                         line)
                             or re.match(r'\*\*\d+[.)]', stripped))
        if new and current:
            units.append((start, '\n'.join(current)))
            current = []
        if stripped:
            if not current:
                start = number
            current.append(line)
            if stripped.startswith(('#', '|')) and not fence:
                units.append((start, '\n'.join(current)))
                current = []
    if current:
        units.append((start, '\n'.join(current)))
    return units


def unit_sentences(unit):
    return [s.strip() for s in re.split(r'(?<=[.!?])\s+(?=[A-Z`*_(\[])', re.sub(r'\s*\n\s*', ' ', unit)) if s.strip()]


def clauses_of(sentence):
    """A sentence's clauses. What follows a colon stays with the clause before it when it has no act of its own
    ("Convert to a skill: `docs/principles.md`")."""
    out = []
    for part in re.split(r'(?<=:)\s+', sentence):
        pieces = [c for c in CLAUSE_SPLIT.split(part) if c and c.strip()]
        if out and out[-1].endswith(':') and pieces and not ACT.search(pieces[0]):
            out[-1] += ' ' + pieces.pop(0)
        out += pieces
    return out


def negated(before, question=False):
    """True when a negation's scope reaches the end of `before` (the text up to an act or a target). In a question a
    leading negative ("Wouldn't a skill help?") asks for the thing, so it negates nothing."""
    before = WHY_NOT.sub('why', before)
    if question:
        before = re.sub(r"^\W*\w+n[’']t\b", '', before)
    for match in reversed(list(NEGATOR.finditer(before))):
        if CANCELS.match(before, match.end()) or re.search(r"(?:\bnot|n[’']t)[ \t]+$", before[:match.start()]):
            continue  # "don't hesitate to", "wouldn't skip", "not overkill": a negation that urges
        gap = re.sub(r'\b(?:skills?|(?:slash[ \t]+)?commands?)[ \t]+or\b', ' ', before[match.end():], flags=re.I)
        return not SCOPE_BREAK.search(gap) and len(gap.split()) <= 8  # "no skill or slash command" stays one list
    return False


def clause_act(clause):
    """The first creation act in a clause that no negation reaches, or None."""
    for act in ACT.finditer(clause):
        if not negated(clause[:act.start()], clause.rstrip().endswith('?')):
            return act
    return None


def rejected(clause):
    """A judgement that rejects the skill, from the skill (or target) on: "a skill would be overkill", "… and decided
    against it". A rejection word before it ("Rejected alternatives aside, turn …") judges something else."""
    target = TARGET.search(clause)
    start = target.start() if target else 0
    reject = REJECTS.search(clause, start)
    return bool(reject) and not REJECT_NEGATED.search(clause[:reject.start()])


def clause_target(clause):
    """The first skill, slash command or command a clause names that no negation reaches, or None."""
    for target in TARGET.finditer(clause):
        if not negated(clause[:target.start()], clause.rstrip().endswith('?')):
            return target
    return None


def set_aside(clause, sentence):
    """True when a skill named in this clause is rejected, negated, a statement of what skills are for, an existing
    skill being run or used, or a skill for another document, so it can't stand for a principles skill."""
    if SET_ASIDE.match(sentence) or rejected(clause) or SKILLS_FIT.search(clause):
        return True
    if USES.search(clause) and not clause_act(clause):
        return True
    if [m for m in OTHER_MD.findall(clause) if 'principles' not in m.lower()] and not PRINCIPLES.search(clause):
        return True
    return all(negated(clause[:m.start()], clause.rstrip().endswith('?')) for m in SKILL_WORD.finditer(clause))


def fails_closed(unit):
    """The fallback (review round 3, M7): a unit (list item, table row or paragraph) that names the principles and
    a skill or slash command fails unless every clause naming a skill sets it aside (see set_aside). Bare "command"
    doesn't count here: reports name check commands next to the principles in their intent paragraph."""
    if not PRINCIPLES.search(unit):
        return False
    for sentence in unit_sentences(unit):
        for clause in clauses_of(sentence):
            if SKILL_WORD.search(clause) and not set_aside(clause, sentence):
                return True
    return False


def principles_skill_units(text):
    """The units (line, text) of a report with a clause that proposes a skill for the principles (see above), or that
    fail closed: the principles and a skill in one unit with nothing setting the skill aside."""
    found = []
    for line, unit in report_units(text):
        if fails_closed(unit):
            found.append((line, unit))
            continue
        named, raised = False, False
        for sentence in unit_sentences(unit):
            if SET_ASIDE.match(sentence):
                named = named or PRINCIPLES.search(sentence) is not None
                continue
            hit = False
            for clause in clauses_of(sentence):
                here = PRINCIPLES.search(clause) is not None
                others = [m for m in OTHER_MD.findall(clause) if 'principles' not in m.lower()]
                source = here or (named and BACK_REFERENCE.search(clause) is not None and not others)
                target = TARGET.search(clause)
                act = clause_act(clause)
                if act and not rejected(clause):
                    if clause_target(clause) and source:
                        hit = True
                    elif raised and not target and POINTS_BACK.match(clause, act.end()) and not others:
                        hit = True  # "…, but worth adding later", "add one when the list grows"
                if target and (here or named):
                    raised = True  # a skill came up with the principles named, proposed or not
                named = named or here
            if hit:
                found.append((line, unit))
                break
    return found


# Rule 4: real repositories.
NOT_PROCEDURE_PAGE = re.compile(r'(?:^|/)(?:i18n|l10n|locales?|translations|reference|references|api)/', re.I)
PAGE = re.compile(r'(?<![\w./-])`?((?:[\w.-]+/)*[\w.-]+\.md)`?', re.I)
# Not documentation pages: instruction files, skill files and anything under .claude/.
NOT_A_PAGE = re.compile(r'(?:^|/)(?:CLAUDE|AGENTS|CLAUDE\.local|SKILL)\.md$|^\.claude/', re.I)
REASON = re.compile(r'\b(?:because|since|as it|so that|reason|why:)', re.I)


def top_changes(text):
    match = re.search(TOP + r'([\s\S]*?)' + SECTION_END, text)
    return match.group(1) if match else ''


def change_items(section):
    """The numbered items of a Top changes section: each column-0 numbered line (or ###/#### numbered heading) with
    the lines under it, up to the next one."""
    items = []
    for line in section.splitlines():
        if re.match(r'(?:#{3,4}[ \t]+)?(?:\*\*)?\d+[.)][ \t]', line):
            items.append(line)
        elif items:
            items[-1] += '\n' + line
    return items


CREATES_SKILL = re.compile(r'\b(?:create|add|write|make|move)\b[^.]{0,60}\.claude/(?:skills|commands)/', re.I)
SKILL_PATH = re.compile(r'`?[\w./-]*(?:\.claude/[\w./-]*|SKILL\.md)`?', re.I)
SKILL_TITLE = re.compile(r'^\W*(?:\d+[.)])?\W*skills?\b\W*:', re.I)  # "**Skill: docs/testing.md**"


def doc_skill_items(text):
    """(page, translation or reference page, a reason given) for each documentation page a numbered Top changes item
    proposes a skill for. An item proposes one when a clause of it (not a Source line) holds a creation act and a
    skill or slash command that no negation reaches and no judgement rejects, as rule 6 reads a clause (skill files'
    paths set aside), when it creates a `.claude/skills/` file, or when its title is "Skill: <page>". Then each page
    the item names counts, outside instruction files, skill files and `.claude/`."""
    found = []
    for item in change_items(top_changes(text)):
        body = '\n'.join(l for l in item.splitlines() if not re.match(r'\s*Source:', l))
        proposal = SKILL_TITLE.match(re.sub(r'^(?:#{3,4}[ \t]+)?\d+[.)][ \t]+', '', item.splitlines()[0])) is not None
        for sentence in unit_sentences(body):
            if proposal:
                break
            if CREATES_SKILL.search(sentence):
                proposal = True
            for clause in clauses_of(SKILL_PATH.sub(' ', sentence)):
                skill = any(not negated(clause[:m.start()]) for m in SKILL_WORD.finditer(clause))
                if skill and clause_act(clause) and not rejected(clause):
                    proposal = True
        if not proposal:
            continue
        pages = []
        for page in PAGE.findall(body):
            if not NOT_A_PAGE.search(page) and page not in pages:
                pages.append(page)
        reasoned = REASON.search(item) is not None
        found += [(page, bool(NOT_PROCEDURE_PAGE.search(page)), reasoned) for page in pages]
    return found


def doc_skills_pass(items):
    """Rule 4 on python-sdk: at most one documentation-page skill, never a translation or reference page, and the
    one allowed item states a reason."""
    return len(items) <= 1 and not any(page for _, page, _ in items) and all(reason for _, _, reason in items)


HISTORY_LINES = (('compatibility-run', re.compile(r'repository\.md:4[0-9]\b|initial compatibility run|3\.9\.6', re.I)),
                 ('retired-hooks', re.compile(r'repository\.md:6[0-9]\b|(?:push|shell-match) hooks?[^.]{0,80}retired|'
                                              r'have been retired', re.I)))


STALE_WORD = re.compile(r"\b(?:histor\w*|past (?:events?|setups?)|narrat\w*|obsolete|stale|outdated|out of date|"
                        r"archaeolog\w*|migration-relative|records? (?:a|one) past|describes? (?:a )?past|"
                        r"no longer (?:needed|true|relevant|applies))", re.I)
STALE_DENIED = re.compile(r"\b(?:not|never|n[’']t|no)\b[ \t]+(?:\w+[ \t]+){0,2}$", re.I)
DECLINE_HEAD = re.compile(r'#+[ \t]+(?:Declined|Not counted)\b', re.I)
# A line kept deliberately: "kept on purpose", "keep them as is". "Fix it on purpose" is not a keep.
KEPT = re.compile(r'\b(?:kept|keep(?:s|ing)?|leave|left)\b[^.]{0,40}?\b(?:on purpose|deliberately|as is)\b', re.I)


def finding_blocks(text):
    """A heading or column-0 numbered item with the bullets and paragraphs under it, up to the next one; a finding
    is often a numbered title with Location and Evidence bullets below it. Units that record a decline ("Declined:",
    "Not counted:", or anything under a Declined heading) are left out."""
    blocks, declined = [], False
    for _, unit in report_units(text):
        if unit.startswith('#'):
            declined = DECLINE_HEAD.match(unit) is not None
        if declined or SET_ASIDE.match(re.sub(r'^\s*(?:[-*+]|\d+[.)])\s+', '', unit)) or KEPT.search(unit):
            continue
        if not blocks or re.match(r'#|(?:\*\*)?\d+[.)]\s', unit):
            blocks.append(unit)
        else:
            blocks[-1] += '\n' + unit
    return blocks


def history_lines(text):
    """Which of the two stale history lines of quickstop's docs/repository.md (#192) a report surfaces: a unit that
    names docs/repository.md, the line (by number or by its words) and calls it history or stale, unnegated. Listing
    the hooks line as a decline doesn't count."""
    hits = set()
    for unit in finding_blocks(text):
        stale = [m for m in STALE_WORD.finditer(unit) if not STALE_DENIED.search(unit[:m.start()])]
        if 'repository.md' not in unit or not stale:
            continue
        for name, pattern in HISTORY_LINES:
            if pattern.search(unit):
                hits.add(name)
    return sorted(hits)


def gate(args):
    """Grade saved reports with the #193 gate graders; prints one JSON line per report."""
    paths = []
    for given in args.reports:
        path = Path(given)
        paths += sorted(path.rglob('*.md')) if path.is_dir() else [path]
    failed = 0
    for path in paths:
        text = path.read_text()
        if args.rule == 'principles-skill':
            units = principles_skill_units(text)
            row = {'report': str(path), 'passed': not units, 'units': [line for line, _ in units]}
        elif args.rule == 'doc-skills':
            items = doc_skill_items(text)
            row = {'report': str(path), 'passed': doc_skills_pass(items), 'items': items}
        else:
            hits = history_lines(text)
            row = {'report': str(path), 'passed': len(hits) == len(HISTORY_LINES), 'lines': hits}
        failed += not row['passed']
        print(json.dumps(row))
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('run', help='run the suite on one arm in a scratch plugin dir')
    p.add_argument('--arm', choices=ARMS, required=True)
    p.add_argument('--model', required=True)
    p.add_argument('--max-cost-usd', type=positive_cost, required=True)
    p.add_argument('--judge-model', default=DEFAULT_JUDGE)
    p.add_argument('--runs', type=positive_int, default=1)
    p.add_argument('--case', help='case name glob passed to claude plugin eval (exact names are safest)')
    p.add_argument('--max-budget-usd', type=positive_cost,
                   help='doctor-combined and claudit-deep: cap per headless call (the nested prompt-audit has its own)')
    p.add_argument('--judge-budget-usd', type=positive_cost, default=0.05, help='doctor-combined: cap per judge vote')
    p.add_argument('--concurrency', type=positive_int, default=1, help='doctor-combined: case runs at once')
    p.add_argument('--plugin', help='plugin under test (claudit arm only; default plugins/claudit)')
    p.add_argument('--invoke', default=DEFAULT_INVOKE, help='claudit arm prompt (claudit-deep: %s)' % DEEP_INVOKE)
    p.add_argument('--web-fetch', action='store_true',
                   help='also grant WebFetch to code.claude.com (--allow-tools and each case allowed_tools)')
    p.add_argument('--output-dir', help='default evals/claudit/results/<UTC timestamp>-<arm>')
    p.add_argument('--keep-scratch', action='store_true')
    p.add_argument('--keep-temp', action='store_true', help="keep each run's sandbox and trace after saving its report")
    p.add_argument('--dry-run', action='store_true', help='assemble the scratch, print the command, do not run')
    p = sub.add_parser('summarize', help='summarize claude plugin eval --json results (several pool one arm)')
    p.add_argument('result', nargs='+')
    p.add_argument('--arm')
    p.add_argument('--web-fetch', action='store_true', default=None,
                   help='label results that do not record whether WebFetch was granted')
    p = sub.add_parser('headless', help='fresh-clone read-only audits of a repository at a commit, graded by script')
    p.add_argument('--repo', required=True, help='clone URL or path')
    p.add_argument('--sha', required=True)
    p.add_argument('--arm', choices=('claudit', 'doctor-combined'), default='claudit')
    p.add_argument('--plugin', help='the candidate plugin bytes (claude --plugin-dir; claudit arm)')
    p.add_argument('--model', required=True)
    p.add_argument('--max-budget-usd', type=positive_cost, required=True, help='per headless call')
    p.add_argument('--runs', type=positive_int, default=3)
    p.add_argument('--invoke', default=DEFAULT_INVOKE)
    p.add_argument('--output-dir', required=True)
    p = sub.add_parser('gate', help='grade saved reports with a #193 gate grader ($0)')
    p.add_argument('--rule', required=True, choices=('principles-skill', 'doc-skills', 'history-lines'),
                   help='principles-skill: f19 rule 6; doc-skills: python-sdk rule 4; history-lines: quickstop rule 4')
    p.add_argument('reports', nargs='+', help='report files, or folders searched for *.md')
    p = sub.add_parser('grade', help="script-check a report against the scan of the same tree")
    p.add_argument('--report', required=True)
    p.add_argument('--scan', required=True)
    p.add_argument('--plugin', help='plugin whose test-data rule applies (default plugins/claudit)')
    args = parser.parse_args()
    try:
        if args.command == 'run':
            return run(args)
        if args.command == 'headless':
            return headless(args)
        if args.command == 'grade':
            return grade(args)
        if args.command == 'gate':
            return gate(args)
        summary = summarize_files(args.result, args.arm, web_fetch=args.web_fetch)
        print(json.dumps(summary, indent=2))
        print(markdown(summary))
        return 0
    except (Failure, OSError, subprocess.CalledProcessError, ValueError, KeyError) as exc:
        print(f'claudit-eval: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
