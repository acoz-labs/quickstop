#!/usr/bin/env python3
"""Validate change plans: every docs/changes/<issue>-<slug>/ folder has a
plan.md with each required section filled in and an Issue section that links
an issue. Folders starting with "_" (the template) are skipped."""
from pathlib import Path
import re
import sys

SECTIONS = ("Issue", "Files that change", "Order of work", "Risks", "Proof", "Rollback")
ISSUE_LINK = re.compile(r"https://github\.com/[\w.-]+/[\w.-]+/issues/\d+|(?<![\w&])(?:[\w.-]+/[\w.-]+)?#\d+\b")
HEADING = re.compile(r"^##[ \t]+(.+?)[ \t]*#*[ \t]*$", re.MULTILINE)
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")

def unfenced(text):
    # Indent lines inside code fences so a "## " there is content, not a heading.
    lines, fence = [], None
    for line in text.splitlines(keepends=True):
        match = FENCE.match(line)
        if fence is None and match:
            fence = match.group(1)
        elif fence and match and match.group(1)[0] == fence[0] and len(match.group(1)) >= len(fence) \
                and not line[match.end():].strip():
            lines.append("    " + line)
            fence = None
            continue
        lines.append("    " + line if fence else line)
    return "".join(lines)

def sections(text):
    parts = HEADING.split(unfenced(text))
    # parts: [preamble, heading1, body1, heading2, body2, ...]
    return {parts[i].strip().lower(): parts[i + 1] for i in range(1, len(parts), 2)}

def problems(plan):
    if not plan.is_file():
        return ["missing plan.md"]
    found = sections(plan.read_text())
    result = []
    for name in SECTIONS:
        body = found.get(name.lower())
        if body is None:
            result.append(f"missing section '{name}'")
        elif not body.strip():
            result.append(f"empty section '{name}'")
    if found.get("issue", "").strip() and not ISSUE_LINK.search(found["issue"]):
        result.append("Issue section does not link an issue")
    return result

def main(root):
    changes = root / "docs" / "changes"
    folders = sorted(p for p in changes.iterdir() if p.is_dir() and not p.name.startswith("_")) if changes.is_dir() else []
    failures = [f"{folder.relative_to(root)}: {issue}" for folder in folders for issue in problems(folder / "plan.md")]
    for failure in failures:
        print(failure, file=sys.stderr)
    if failures:
        return 1
    print(f"Change plans valid ({len(folders)})")
    return 0

if __name__ == "__main__":
    sys.exit(main(Path(sys.argv[1]) if len(sys.argv) > 1 else Path.cwd()))
