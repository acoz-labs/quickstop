#!/usr/bin/env python3
"""Run sotsog's release gate: the same research-and-decide task with and without the plugin, graded the same way."""
import sys

if sys.version_info < (3, 11):
    sys.exit('sotsog-eval requires Python 3.11+; put the pinned interpreter first in PATH')

import argparse
import concurrent.futures
import csv
import datetime as dt
import hashlib
import json
import math
import os
from pathlib import Path
import shutil
import statistics
import subprocess
import tempfile
import threading
import time

ROOT = Path(__file__).resolve().parent.parent
SUITE_PATH = 'evals/sotsog'
RUNNER_PATH = 'bin/sotsog-eval'
SUITE = ROOT / SUITE_PATH
PLUGIN = ROOT / 'plugins/sotsog'
PLUGIN_NAME = 'sotsog'
sys.dont_write_bytecode = True
sys.path.insert(0, str(SUITE))
import graders as g  # noqa: E402  (frozen with the suite)

ARMS = ('baseline', 'sotsog')
SAMPLES = ('good', 'bad', 'borderline-pass', 'borderline-fail', 'plain')
TASK_TOOLS = ('Read', 'Glob', 'Grep', 'Write', 'Edit', 'Skill')
ISOLATION = ('--setting-sources', 'project,local', '--strict-mcp-config', '--no-session-persistence')
ENV = {'CLAUDE_CODE_DISABLE_AUTO_MEMORY': '1', 'DISABLE_AUTOUPDATER': '1'}
REAL_CONFIG = ('.claude/settings.json', '.claude/plugins/*.json')
HARD_CEILING = 20.0
DEFAULT_STOP_LINE = 14.0
GATE_RUNS = 3
LEDGER_FIELDS = ('time_utc', 'invocation', 'kind', 'arm', 'case', 'item', 'cap_usd', 'cost_usd', 'cumulative_usd')


class Failure(Exception):
    pass


def positive_cost(value):
    cost = float(value)
    if not (math.isfinite(cost) and cost > 0):
        raise argparse.ArgumentTypeError('cost must be greater than 0')
    return cost


def stop_line(value):
    cost = positive_cost(value)
    if cost > HARD_CEILING:
        raise argparse.ArgumentTypeError(f'the stop line can never pass the ${HARD_CEILING:.0f} cap')
    return cost


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


# Spend: one ledger row per paid call, and a stop line no call may cross.

class Ledger:
    """The issue's spend ledger. Before a call it reserves the call's cap; it refuses a call whose cap would take
    the ledger total plus every cap in flight past the stop line. When that happens with calls in flight, it waits
    for them to settle, so concurrency falls to one call at a time near the line instead of refusing early."""

    def __init__(self, path, line, invocation, max_cost=None):
        if line > HARD_CEILING:
            raise Failure(f'the stop line can never pass the ${HARD_CEILING:.0f} cap')
        self.path, self.line, self.invocation, self.max_cost = Path(path), line, invocation, max_cost
        self.reserved, self.in_flight, self.spent = 0.0, 0, 0.0
        self.cond = threading.Condition()

    def total(self):
        total = 0.0
        if self.path.is_file():
            with self.path.open(newline='') as handle:
                for row in csv.DictReader(handle):
                    try:
                        total = float(row['cumulative_usd'])
                    except (KeyError, TypeError, ValueError):
                        continue
        return total

    def reserve(self, cap):
        with self.cond:
            while True:
                within_invocation = self.max_cost is None or self.spent + self.reserved + cap <= self.max_cost + 1e-9
                if self.total() + self.reserved + cap <= self.line + 1e-9 and within_invocation:
                    self.reserved += cap
                    self.in_flight += 1
                    return cap
                if not self.in_flight:
                    return None
                self.cond.wait()

    def settle(self, grant, cost, kind, arm='', case='', item=''):
        with self.cond:
            total = self.total() + cost
            new = not self.path.is_file()
            self.path.parent.mkdir(parents=True, exist_ok=True)
            with self.path.open('a', newline='') as handle:
                writer = csv.writer(handle)
                if new:
                    writer.writerow(LEDGER_FIELDS)
                writer.writerow([dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), self.invocation,
                                 kind, arm, case, item, f'{grant:.4f}', f'{cost:.6f}', f'{total:.6f}'])
            self.reserved -= grant
            self.in_flight -= 1
            self.spent += cost
            self.cond.notify_all()


# Model calls.

def claude_env():
    return dict(os.environ, **ENV)


def call_claude(args, cwd, timeout):
    try:
        return subprocess.run(['claude', '-p', *args], cwd=cwd, env=claude_env(), stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as error:
        out = error.stdout.decode() if isinstance(error.stdout, bytes) else (error.stdout or '')
        return subprocess.CompletedProcess(error.cmd, 124, out, f'timed out after {timeout}s')


def parse_stream(text):
    records = []
    for line in text.splitlines():
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


def first(records, kind, subtype=None):
    return next((r for r in records if r.get('type') == kind and (subtype is None or r.get('subtype') == subtype)), {})


def task_prompt(case, research):
    return case['prompt'].replace('{research}', str(research))


def task_command(prompt, arm, model, effort, plugin_dir, research, cap):
    command = [prompt, '--model', model, '--effort', effort, '--tools', ','.join(TASK_TOOLS),
               '--allowedTools', *TASK_TOOLS, '--add-dir', str(research),
               '--output-format', 'stream-json', '--verbose', '--max-budget-usd', f'{cap:.4f}', *ISOLATION]
    if arm == 'sotsog':
        command += ['--plugin-dir', str(plugin_dir)]
    return command


def init_proof(init, arm, model, plugin_dir, version):
    """Why this run's init record does not prove the arm's setup, or [] when it does."""
    problems = []
    if not init:
        return ['no init record']
    if init.get('model') != model:
        problems.append(f"init model {init.get('model')!r}, expected {model!r}")
    plugins = [p for p in init.get('plugins') or [] if isinstance(p, dict) and p.get('name') == PLUGIN_NAME]
    if arm == 'sotsog':
        if not any(p.get('version') == version and Path(str(p.get('path'))).resolve() == Path(plugin_dir).resolve()
                   for p in plugins):
            problems.append(f'init does not list {PLUGIN_NAME} {version} from {plugin_dir}')
    elif plugins:
        problems.append(f'{PLUGIN_NAME} is loaded in the {arm} arm')
    if init.get('mcp_servers'):
        problems.append(f"MCP servers loaded: {init.get('mcp_servers')}")
    return problems


def skill_loaded(records):
    """Whether the run called the sotsog skill (it has to trigger from its description)."""
    for record in records:
        content = (record.get('message') or {}).get('content') if record.get('type') == 'assistant' else None
        for block in content or []:
            if isinstance(block, dict) and block.get('type') == 'tool_use' and block.get('name') == 'Skill':
                if PLUGIN_NAME in json.dumps(block.get('input')):
                    return True
    return False


def snapshot(root):
    root = Path(root)
    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in sorted(root.rglob('*')) if p.is_file()}


def changed_documents(before, after):
    """Markdown files the run added or changed."""
    return sorted(name for name, digest in after.items() if name.endswith('.md') and before.get(name) != digest)


def run_task(case, arm, settings, plugin_dir, version, ledger, cap, directory):
    """One task run. Returns its record; the decision document, if exactly one was written, is document.md."""
    directory.mkdir(parents=True, exist_ok=True)
    grant = ledger.reserve(cap)
    if grant is None:
        return {'refused': f'stop line ${ledger.line:.2f}: no room for a ${cap:.2f} run'}
    work = Path(tempfile.mkdtemp(prefix='sotsog-run-')).resolve()
    repo, research = work / 'repo', work / 'research'
    started = time.monotonic()
    try:
        shutil.copytree(SUITE / 'repo', repo)
        shutil.copytree(case['dir'] / 'research', research)
        before, research_before = snapshot(repo), snapshot(research)
        prompt = task_prompt(case, research)
        done = call_claude(task_command(prompt, arm, settings['model'], settings['effort'], plugin_dir, research,
                                        grant), repo, timeout=1800)
        after, research_after = snapshot(repo), snapshot(research)
        documents = changed_documents(before, after)
        (directory / 'documents').mkdir(exist_ok=True)
        for name in documents:
            target = directory / 'documents' / name.replace('/', '__')
            target.write_text((repo / name).read_text(errors='replace'))
        if len(documents) == 1:
            (directory / 'document.md').write_text((repo / documents[0]).read_text(errors='replace'))
        workspace = {'added_or_changed': sorted(n for n in after if before.get(n) != after[n]),
                     'removed': sorted(n for n in before if n not in after),
                     'research_changed': sorted(n for n in set(research_before) | set(research_after)
                                                if research_before.get(n) != research_after.get(n)),
                     'documents': documents, 'work_dir': str(work)}
    finally:
        shutil.rmtree(work, ignore_errors=True)
    records = parse_stream(done.stdout)
    result = first(records, 'result')
    cost = number(result.get('total_cost_usd'))
    ledger.settle(grant, cost, 'task', arm, case['name'], directory.name)
    (directory / 'transcript.jsonl').write_text(done.stdout)
    init = first(records, 'system', 'init')
    (directory / 'init.json').write_text(json.dumps(init, indent=2) + '\n')
    (directory / 'workspace.json').write_text(json.dumps(workspace, indent=2) + '\n')
    (directory / 'prompt.md').write_text(prompt)
    problems = init_proof(init, arm, settings['model'], plugin_dir, version)
    replied = any(r.get('type') == 'assistant' for r in records)
    error = done.returncode != 0 or result.get('is_error') or result.get('subtype') != 'success'
    invalid = bool(problems) or (error and not replied)
    return {'arm': arm, 'case': case['name'], 'invalid': invalid, 'problems': problems,
            'error': f"exit {done.returncode}, subtype {result.get('subtype')!r}, stderr {done.stderr[-300:]!r}"
            if error else None,
            'documents': documents, 'skill_loaded': skill_loaded(records), 'model': init.get('model'),
            'claude_version': init.get('claude_code_version'), 'cost_usd': round(cost, 6), 'cap_usd': grant,
            'duration_seconds': round(number(result.get('duration_ms')) / 1000, 1),
            'wall_seconds': round(time.monotonic() - started, 1), 'turns': result.get('num_turns')}


def judge_command(kind, prompt, model, cap, suite):
    return [prompt, '--model', model, '--system-prompt', g.judge_prompt_text(kind, suite), '--tools', '',
            '--json-schema', json.dumps(g.SCHEMAS[kind]), '--output-format', 'json',
            '--max-budget-usd', f'{cap:.4f}', *ISOLATION]


def run_judge(kind, prompt, model, ledger, cap, path, who, suite=g.SUITE):
    """One judge call, retried once on failure. Its structured verdict, or None (not graded)."""
    for attempt in (1, 2):
        grant = ledger.reserve(cap)
        if grant is None:
            return None, f'judge {kind}: stop line reached'
        cwd = Path(tempfile.mkdtemp(prefix='sotsog-judge-')).resolve()
        try:
            done = call_claude(judge_command(kind, prompt, model, grant, suite), cwd, timeout=300)
        finally:
            shutil.rmtree(cwd, ignore_errors=True)
        try:
            record = json.loads(done.stdout)
        except ValueError:
            record = {}
        record = record if isinstance(record, dict) else {}
        ledger.settle(grant, number(record.get('total_cost_usd')), f'judge {kind}', *who)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.with_name(f'{path.stem}-attempt-{attempt}.json').write_text(json.dumps(
            {'kind': kind, 'model': model, 'prompt': prompt, 'record': record, 'exit': done.returncode,
             'stderr': done.stderr[-500:]}, indent=2) + '\n')
        verdict = record.get('structured_output')
        if not done.returncode and not record.get('is_error') and isinstance(verdict, dict):
            return verdict, None
    return None, f"judge {kind} failed twice: exit {done.returncode}, subtype {record.get('subtype')!r}"


def judge_document(document, case, script, model, ledger, cap, directory, who):
    """Every judge the document needs, in order; the reader's notes feed the comparator."""
    key = case['key']
    judged, errors = {}, []
    for kind in g.judges_needed(key, script['outcome']['value'], script['depth_script']):
        if kind == 'compare':
            if 'reader' not in judged:
                continue
            prompt = g.compare_prompt(key, judged['reader'])
        elif kind == 'depth':
            prompt = g.depth_prompt(document, case, script['depth_script']['cited'])
        elif kind == 'gaps':
            prompt = g.gaps_prompt(document, key)
        else:
            prompt = g.document_prompt(document)
        verdict, error = run_judge(kind, prompt, model, ledger, cap, directory / f'{kind}.json', who)
        if error:
            errors.append(error)
        else:
            judged[kind] = verdict
    return judged, errors


def grade(document, case, judges, model=None, ledger=None, cap=None, directory=None, who=('', '', '')):
    script = g.script_grades(document, case)
    judged, errors = ({}, [])
    if judges:
        judged, errors = judge_document(document, case, script, model, ledger, cap, directory, who)
    return {'script': script, 'judged': judged, 'judge_errors': errors,
            'grades': g.final_grades(case, script, judged) if judges else None}


# Evidence and guards.

def git(*args):
    done = subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else None


def tree_digest(root):
    digest = hashlib.sha256()
    for path in sorted(Path(root).rglob('*')):
        if path.is_file() and '__pycache__' not in path.parts and path.suffix != '.pyc':
            digest.update(str(path.relative_to(root)).encode() + b'\0' + path.read_bytes() + b'\0')
    return digest.hexdigest()


def real_config_digests(home=None):
    home = Path(home or Path.home())
    paths = sorted({path for pattern in REAL_CONFIG for path in home.glob(pattern) if path.is_file()})
    return {str(path.relative_to(home)): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}


def frozen_ids():
    """The suite tree and runner blob at HEAD, and whether the working tree is clean. Any untracked file under
    the suite, ignored or not, makes it unclean: fixtures are copied whole into each run."""
    stray = (git('ls-files', '--others', '--', SUITE_PATH) or '').splitlines()
    return {'suite_tree': git('rev-parse', f'HEAD:{SUITE_PATH}'), 'runner_blob': git('rev-parse', f'HEAD:{RUNNER_PATH}'),
            'clean': not git('status', '--porcelain') and not stray, 'stray_files': stray}


def extraction_tree():
    """The tree a fresh checkout of HEAD writes, recomputed from an extracted archive (rebase-merge proof)."""
    scratch = Path(tempfile.mkdtemp(prefix='sotsog-extract-'))
    try:
        archive = subprocess.run(['git', '-C', str(ROOT), 'archive', 'HEAD'], capture_output=True)
        subprocess.run(['tar', '-x', '-C', str(scratch)], input=archive.stdout, check=True)
        subprocess.run(['git', 'init', '-q', str(scratch)], check=True)
        subprocess.run(['git', '-C', str(scratch), 'add', '-A'], check=True)
        done = subprocess.run(['git', '-C', str(scratch), 'write-tree'], capture_output=True, text=True, check=True)
        return done.stdout.strip()
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def candidate_text(ids, plugin_source):
    lines = [f'head: {git("rev-parse", "HEAD")}', f'tree: {git("rev-parse", "HEAD^{tree}")}',
             f'extraction write-tree: {extraction_tree()}']
    if plugin_source:
        rel = os.path.relpath(Path(plugin_source).resolve(), ROOT)
        lines += [f'plugin tree ({rel} at HEAD): {git("rev-parse", f"HEAD:{rel}")}',
                  f'plugin bytes digest (retained copy): {tree_digest(plugin_source)}']
    lines += [f'suite tree ({SUITE_PATH} at HEAD): {ids["suite_tree"]}',
              f'runner blob ({RUNNER_PATH} at HEAD): {ids["runner_blob"]}', f'working tree clean: {ids["clean"]}']
    return '\n'.join(lines) + '\n'


def claude_version():
    done = subprocess.run(['claude', '--version'], capture_output=True, text=True)
    return done.stdout.strip()


def calibration_problems(calibration, cases, ids, judge_model):
    """Why a calibration doesn't clear a counted run on this suite, or [] when it does."""
    if calibration is None:
        return ['no calibration: a gate run needs a passing `calibrate --judges` on the same suite']
    problems = [] if calibration.get('judges') else ['calibration ran without the judges']
    if calibration.get('judge_model') != judge_model:
        problems.append(f"calibration judge model {calibration.get('judge_model')!r} differs from {judge_model!r}")
    recorded = calibration.get('candidate') or {}
    if not recorded.get('clean'):
        problems.append('calibration ran on a dirty working tree')
    problems += [f'calibration {key} {recorded.get(key)} differs from {ids.get(key)}'
                 for key in ('suite_tree', 'runner_blob') if recorded.get(key) != ids.get(key)]
    graded = {(r.get('case'), r.get('sample')) for r in calibration.get('rows') or []}
    problems += [f'calibration did not grade {name} {sample}' for name in cases for sample in SAMPLES
                 if (name, sample) not in graded]
    problems += [f"calibration row failed: {r.get('case')} {r.get('sample')} {r.get('grader')}"
                 for r in calibration.get('rows') or [] if not r.get('ok')]
    return problems


# Calibration.

def load_expected(case):
    return json.loads((case['dir'] / 'calibration/expected.json').read_text())


def calibrate(args):
    cases = g.load_cases()
    ids = frozen_ids()
    ledger = None
    if args.judges:
        if not args.ledger:
            raise Failure('judge calibration is paid: pass --ledger')
        ledger = Ledger(args.ledger, args.stop_line, f'calibrate {dt.datetime.now(dt.timezone.utc):%Y%m%dT%H%M%SZ}',
                        args.max_cost_usd)
    out = Path(args.output_dir).resolve() if args.output_dir else None
    if out:
        if out.exists() and any(out.iterdir()):
            raise Failure(f'output dir is not empty: {out}')
        out.mkdir(parents=True, exist_ok=True)
    jobs = [(name, sample) for name in cases for sample in SAMPLES]

    def one(job):
        name, sample = job
        case = cases[name]
        document = (case['dir'] / 'calibration' / f'{sample}.md').read_text()
        directory = (out / name / sample) if out else None
        graded = grade(document, case, args.judges, args.judge_model, ledger, args.judge_max_usd,
                       directory, ('calibration', name, sample))
        expected = load_expected(case)[sample]
        grades = graded['grades'] or {'structure': graded['script']['structure']['passed'],
                                      'outcome': graded['script']['outcome']['passed']}
        rows = g.calibration_rows(case, sample, expected, grades, graded['script'], args.judges)
        if directory:
            directory.mkdir(parents=True, exist_ok=True)
            (directory / 'graded.json').write_text(json.dumps(dict(graded, rows=rows), indent=2) + '\n')
        return rows

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        rows = [row for result in pool.map(one, jobs) for row in result]
    failed = [r for r in rows if not r['ok']]
    calibration = {'judges': bool(args.judges), 'judge_model': args.judge_model if args.judges else None,
                   'claude_version': claude_version() if args.judges else None, 'candidate': ids,
                   'rows': rows, 'passed': not failed, 'spent_usd': round(ledger.spent, 6) if ledger else 0}
    if out:
        (out / 'calibration.json').write_text(json.dumps(calibration, indent=2) + '\n')
        (out / 'CANDIDATE.txt').write_text(candidate_text(ids, None))
    print(f"Calibration ({'script and judges' if args.judges else 'script graders only'}): "
          f'{len(rows) - len(failed)} of {len(rows)} checks as expected across {len(jobs)} samples')
    for r in failed:
        print(f"  MISS {r['case']} {r['sample']} {r['grader']}: expected {r['expected']}, got {r['got']}")
    if ledger:
        print(f'Spent ${ledger.spent:.4f}; ledger total ${ledger.total():.4f}')
    return 0 if not failed else 1


# Runs.

def run(args):
    all_cases = g.load_cases()
    names = args.case or list(all_cases)
    unknown = [name for name in names if name not in all_cases]
    if unknown:
        raise Failure(f'unknown case: {", ".join(unknown)}')
    cases = {name: all_cases[name] for name in names}
    arms = args.arm or list(ARMS)
    ids = frozen_ids()
    calibration = None
    if args.stage == 'gate':
        if args.case or args.arm or args.runs != GATE_RUNS:
            raise Failure(f'the gate runs every case in both arms, {GATE_RUNS} runs each')
        if not ids['clean']:
            raise Failure('the gate needs a clean working tree' +
                          (f"; untracked files in the suite: {', '.join(ids['stray_files'])}" if ids['stray_files'] else ''))
        if not args.calibration:
            raise Failure('the gate needs --calibration: the output dir of a passing `calibrate --judges`')
        calibration = json.loads((Path(args.calibration) / 'calibration.json').read_text())
        problems = calibration_problems(calibration, all_cases, ids, args.judge_model)
        if problems:
            raise Failure('the calibration does not clear this run: ' + '; '.join(problems))
    out = Path(args.output_dir).resolve()
    if out.exists() and any(out.iterdir()):
        raise Failure(f'output dir is not empty: {out}')
    out.mkdir(parents=True, exist_ok=True)
    plugin_dir, version, digest = None, None, None
    if 'sotsog' in arms:
        source = Path(args.plugin).resolve() if args.plugin else PLUGIN
        plugin_dir = out / 'plugin'
        shutil.copytree(source, plugin_dir, ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
        version = json.loads((plugin_dir / '.claude-plugin/plugin.json').read_text()).get('version')
        digest = tree_digest(plugin_dir)
    (out / 'CANDIDATE.txt').write_text(candidate_text(ids, plugin_dir))
    (out / 'candidate.json').write_text(json.dumps(ids, indent=2) + '\n')
    if calibration:
        (out / 'calibration.json').write_text(json.dumps(calibration, indent=2) + '\n')
    suite = {'stage': args.stage, 'arms': arms, 'runs': args.runs, 'cases': names}
    (out / 'suite.json').write_text(json.dumps(suite, indent=2) + '\n')
    settings = {'model': args.model, 'effort': args.effort, 'judge_model': args.judge_model,
                'claude_version': claude_version(), 'plugin': f'{PLUGIN_NAME} {version} via --plugin-dir (sotsog arm only)'
                if plugin_dir else None, 'task_tools': list(TASK_TOOLS), 'isolation': list(ISOLATION), 'env': ENV,
                'task_max_usd': args.task_max_usd, 'judge_max_usd': args.judge_max_usd, 'stop_line': args.stop_line,
                'max_cost_usd': args.max_cost_usd,
                'jobs': args.jobs, 'ledger': str(Path(args.ledger).resolve())}
    (out / 'settings.json').write_text(json.dumps(settings, indent=2) + '\n')
    ledger = Ledger(args.ledger, args.stop_line, f'{args.stage} {out.name}', args.max_cost_usd)
    print(f'Ledger total before: ${ledger.total():.4f}; stop line ${args.stop_line:.2f}', flush=True)
    before = real_config_digests()
    order = [(name, arm) for name in names for arm in arms]
    jobs = [(name, arm, n) for n in range(1, args.runs + 1) for name, arm in order]

    def one(job):
        name, arm, n = job
        folder = out / f'{name}-{arm}'
        record, attempts = None, 0
        while attempts < 2:
            attempts += 1
            directory = folder / f'run-{n}' / f'attempt-{attempts}'
            record = run_task(cases[name], arm, settings, plugin_dir, version, ledger, args.task_max_usd, directory)
            if 'refused' in record or not record['invalid']:
                break
        record.update(run=n, case=name, arm=arm, attempts=attempts, attempt_dir=str(directory.relative_to(out)))
        if 'refused' not in record and not record['invalid']:
            document = (directory / 'document.md').read_text() if (directory / 'document.md').is_file() else ''
            if document and not args.no_judges:
                record.update(grade(document, cases[name], True, args.judge_model, ledger, args.judge_max_usd,
                                    directory / 'judges', (arm, name, f'run-{n}')))
            elif document:
                record.update(grade(document, cases[name], False))
        (folder / f'run-{n}').mkdir(parents=True, exist_ok=True)
        (folder / f'run-{n}' / 'record.json').write_text(json.dumps(record, indent=2) + '\n')
        state = ('REFUSED' if 'refused' in record else 'INVALID' if record['invalid'] else
                 f"{len(record['documents'])} document(s)")
        print(f"{arm} {name} run {n}: {state} ${record.get('cost_usd', 0):.4f} "
              f"(ledger ${ledger.total():.4f})", flush=True)
        return record

    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            list(pool.map(one, jobs))
    finally:
        after = real_config_digests()
        problems = [f'~/{name} changed during the run' for name in sorted(set(before) | set(after))
                    if before.get(name) != after.get(name)]
        if plugin_dir and tree_digest(plugin_dir) != digest:
            problems.append('retained plugin bytes changed during the run')
        (out / 'guard.json').write_text(json.dumps({'patterns': list(REAL_CONFIG), 'before': before, 'after': after,
                                                    'problems': problems}, indent=2) + '\n')
        print(f'Spent ${ledger.spent:.4f} this invocation; ledger total ${ledger.total():.4f}')
    summary = summarize(out)
    print(markdown(summary))
    return 0 if summary['complete'] else 1


def regrade(args):
    """Regrade a result dir's documents: script graders at $0, and the judges again with --judges (paid)."""
    out = Path(args.result_dir).resolve()
    cases = g.load_cases()
    ledger = Ledger(args.ledger, args.stop_line, f'regrade {out.name}', args.max_cost_usd) if args.judges else None
    if args.judges and not args.ledger:
        raise Failure('regrading with judges is paid: pass --ledger')
    for path in sorted(out.glob('*-*/run-*/record.json')):
        record = json.loads(path.read_text())
        if 'refused' in record or record.get('invalid'):
            continue
        directory = out / record['attempt_dir']
        document_path = directory / 'document.md'
        if not document_path.is_file():
            continue
        stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        record.update(grade(document_path.read_text(), cases[record['case']], args.judges, args.judge_model, ledger,
                            args.judge_max_usd, directory / f'judges-regrade-{stamp}',
                            (record['arm'], record['case'], f"run-{record['run']}")))
        path.write_text(json.dumps(record, indent=2) + '\n')
    summary = summarize(out)
    print(markdown(summary))
    return 0


# Summary and bars.

def load_records(out):
    return [json.loads(p.read_text()) for p in sorted(Path(out).glob('*-*/run-*/record.json'))]


def run_grades(record, case):
    """A run's grades, or None when it is invalid, refused or ungraded. A run with no single document fails
    every grader: that's the arm's doing, not the eval's."""
    if 'refused' in record or record.get('invalid'):
        return None
    if len(record.get('documents') or []) != 1:
        failed = {'structure': False, 'outcome': False, 'outcome_value': None,
                  'cold_read': {item: False for item in g.ITEMS}, 'depth': False}
        if case['key']['go']:
            failed['brief'] = False
        if 'gaps' in case['key']:
            failed['gaps'] = {gap: False for gap in g.GAPS}
        return failed
    return record.get('grades')


def arm_metrics(records, cases, arm, favourable):
    """Per-arm counts. `favourable` decides what an invalid, refused or ungraded result counts as: a pass for
    the baseline in the strictly-above comparisons, a miss for sotsog's own thresholds."""
    rows = [r for r in records if r['arm'] == arm]
    m = {'runs': len(rows), 'invalid_or_refused': 0, 'ungraded': 0, 'structure': 0, 'outcome': 0, 'cold_read': 0,
         'cold_read_items': 0, 'brief_yes': 0, 'brief_runs': 0, 'open_questions': [], 'open_questions_ungraded': 0,
         'gaps_both': 0, 'gaps_runs': 0, 'flip': 0, 'flip_runs': 0, 'depth': 0, 'skill_loaded': 0,
         'outcomes': {}, 'task_costs': [], 'durations': [], 'unread_verdicts': []}
    for r in rows:
        case = cases[r['case']]
        grades = run_grades(r, case)
        m['task_costs'] += [r['cost_usd']] if 'cost_usd' in r else []
        m['durations'] += [r['duration_seconds']] if 'duration_seconds' in r else []
        m['skill_loaded'] += bool(r.get('skill_loaded'))
        if grades is None:
            if 'refused' in r or r.get('invalid'):
                m['invalid_or_refused'] += 1
            else:
                m['ungraded'] += 1
        def count(value):
            return favourable if value is None else bool(value)
        g_ = grades or {}
        m['structure'] += count(g_.get('structure') if grades else None)
        m['outcome'] += count(g_.get('outcome') if grades else None)
        value = g_.get('outcome_value')
        m['outcomes'][value or 'unread'] = m['outcomes'].get(value or 'unread', 0) + 1
        if grades and not value:
            m['unread_verdicts'].append(f"{r['case']} run {r['run']}: {(r.get('script') or {}).get('outcome', {}).get('text', '')!r}")
        cold = g_.get('cold_read') if grades else None
        for item in g.ITEMS:
            m['cold_read'] += count(None if cold is None else cold[item])
            m['cold_read_items'] += 1
        if case['key']['go']:
            m['brief_runs'] += 1
            m['brief_yes'] += count(g_.get('brief') if grades else None)
        if grades and value in ('no', 'not now'):
            if g_.get('open_questions') is None:
                m['open_questions_ungraded'] += 1
            else:
                m['open_questions'].append(g_['open_questions'])
        if 'gaps' in case['key']:
            m['gaps_runs'] += 1
            gaps = g_.get('gaps') if grades else None
            m['gaps_both'] += favourable if gaps is None else all(gaps.values())
        if case['name'].endswith('flip'):
            m['flip_runs'] += 1
            m['flip'] += count(g_.get('outcome') if grades else None)
        m['depth'] += count(g_.get('depth') if grades else None)
    m['mean_task_cost_usd'] = round(statistics.mean(m['task_costs']), 4) if m['task_costs'] else None
    m['max_task_cost_usd'] = round(max(m['task_costs']), 4) if m['task_costs'] else None
    m['mean_duration_seconds'] = round(statistics.mean(m['durations']), 1) if m['durations'] else None
    m['cold_read_share'] = m['cold_read'] / m['cold_read_items'] if m['cold_read_items'] else None
    return m


def bars(sotsog, baseline):
    """The issue's seven pass bars from sotsog's strict counts and the baseline's favourable counts."""
    oq = sotsog['open_questions']
    oq_ok = (sotsog['open_questions_ungraded'] == 0 and bool(oq) and g.median(oq) == 0 and max(oq) <= 1)
    share = sotsog['cold_read_share'] or 0
    return [
        {'bar': '1 Structure', 'sotsog': f"{sotsog['structure']}/{sotsog['runs']}", 'needs': '15/15',
         'passed': sotsog['structure'] == 15},
        {'bar': '2 Outcome', 'sotsog': f"{sotsog['outcome']}/{sotsog['runs']}",
         'baseline': f"{baseline['outcome']}/{baseline['runs']}", 'needs': '>= 14/15 and more than baseline',
         'passed': sotsog['outcome'] >= 14 and sotsog['outcome'] > baseline['outcome']},
        {'bar': '3 Cold read', 'sotsog': f"{sotsog['cold_read']}/{sotsog['cold_read_items']} ({share:.0%}); "
         f"brief {sotsog['brief_yes']}/{sotsog['brief_runs']}",
         'baseline': f"{baseline['cold_read']}/{baseline['cold_read_items']}",
         'needs': '>= 90% and more than baseline; brief >= 5/6',
         'passed': share >= 0.9 and sotsog['cold_read'] * baseline['cold_read_items'] >
         baseline['cold_read'] * sotsog['cold_read_items'] and sotsog['brief_yes'] >= 5},
        {'bar': '4 Open questions', 'sotsog': f"counts {oq} (ungraded {sotsog['open_questions_ungraded']})",
         'needs': 'median 0, none above 1', 'passed': oq_ok},
        {'bar': '5 Case 4 gaps', 'sotsog': f"{sotsog['gaps_both']}/{sotsog['gaps_runs']}", 'needs': '3/3',
         'passed': sotsog['gaps_both'] == 3},
        {'bar': '6 Case 5 flip', 'sotsog': f"{sotsog['flip']}/{sotsog['flip_runs']}", 'needs': '3/3',
         'passed': sotsog['flip'] == 3},
        {'bar': '7 Depth', 'sotsog': f"{sotsog['depth']}/{sotsog['runs']}", 'needs': '>= 14/15',
         'passed': sotsog['depth'] >= 14},
    ]


def summarize(out):
    out = Path(out)
    cases = g.load_cases()
    suite = json.loads((out / 'suite.json').read_text())
    records = load_records(out)
    problems = []
    ids = json.loads((out / 'candidate.json').read_text())
    head = frozen_ids()
    problems += [f'result {key} {ids.get(key)} differs from HEAD {head.get(key)} (the suite changed)'
                 for key in ('suite_tree', 'runner_blob') if ids.get(key) != head.get(key)]
    guard = json.loads((out / 'guard.json').read_text()) if (out / 'guard.json').is_file() else {'problems': ['no guard.json']}
    problems += guard['problems']
    seen = {(r['case'], r['arm'], r['run']) for r in records}
    problems += [f'missing {name} {arm} run {n}' for name in suite['cases'] for arm in suite['arms']
                 for n in range(1, suite['runs'] + 1) if (name, arm, n) not in seen]
    per_arm = {}
    for arm in suite['arms']:
        per_arm[arm] = {'strict': arm_metrics(records, cases, arm, False),
                        'favourable': arm_metrics(records, cases, arm, True)}
    gate = None
    if suite['stage'] == 'gate':
        if not (out / 'calibration.json').is_file():
            problems.append('gate result has no calibration.json')
        gate = bars(per_arm['sotsog']['strict'], per_arm['baseline']['favourable'])
    summary = {'stage': suite['stage'], 'complete': not problems, 'problems': problems, 'arms': per_arm,
               'bars': gate, 'passed': bool(gate) and not problems and all(b['passed'] for b in gate)}
    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    (out / 'summary.md').write_text(markdown(summary))
    return summary


def markdown(summary):
    lines = [f"# sotsog eval: {summary['stage']}", '',
             f"Complete: {'yes' if summary['complete'] else 'no'}" + (f"; gate {'PASSED' if summary['passed'] else 'FAILED'}"
                                                                      if summary['bars'] else ''), '']
    lines += [f'- Problem: {p}' for p in summary['problems']]
    lines += ['', '| Arm | Runs | Invalid or refused | Ungraded | Structure | Outcome | Cold read | Brief | '
              'Open questions | Gaps | Flip | Depth | Skill loaded | Mean task $ | Max task $ | Mean time s |',
              '|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|']
    for arm, both in summary['arms'].items():
        m = both['strict']
        lines.append(f"| {arm} | {m['runs']} | {m['invalid_or_refused']} | {m['ungraded']} | {m['structure']} | "
                     f"{m['outcome']} | {m['cold_read']}/{m['cold_read_items']} | {m['brief_yes']}/{m['brief_runs']} | "
                     f"{m['open_questions']} | {m['gaps_both']}/{m['gaps_runs']} | {m['flip']}/{m['flip_runs']} | "
                     f"{m['depth']} | {m['skill_loaded']} | {m['mean_task_cost_usd']} | {m['max_task_cost_usd']} | "
                     f"{m['mean_duration_seconds']} |")
    for arm, both in summary['arms'].items():
        m = both['strict']
        lines += ['', f"{arm} outcomes: {m['outcomes']}"]
        lines += [f'- unread verdict: {u}' for u in m['unread_verdicts']]
    if summary['bars']:
        lines += ['', '| Bar | sotsog | Baseline (favourable) | Needs | Result |', '|---|---|---|---|---|']
        lines += [f"| {b['bar']} | {b['sotsog']} | {b.get('baseline', '')} | {b['needs']} | "
                  f"{'pass' if b['passed'] else 'FAIL'} |" for b in summary['bars']]
    return '\n'.join(lines) + '\n'


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)

    def paid(p):
        p.add_argument('--ledger', help='CSV spend ledger; every paid call appends a row')
        p.add_argument('--stop-line', type=stop_line, default=DEFAULT_STOP_LINE,
                       help=f'refuse any call that would take the ledger past this (default {DEFAULT_STOP_LINE}, '
                       f'never above {HARD_CEILING})')
        p.add_argument('--max-cost-usd', type=positive_cost,
                       help='ceiling for this whole invocation; no call starts that could pass it')
        p.add_argument('--judge-model', default='claude-sonnet-5-5')
        p.add_argument('--judge-max-usd', type=positive_cost, default=0.10)

    p = sub.add_parser('calibrate', help='grade the hand-written samples; script graders cost nothing')
    p.add_argument('--judges', action='store_true', help='also run the judges (paid)')
    p.add_argument('--output-dir')
    p.add_argument('--jobs', type=int, default=3)
    paid(p)
    p.set_defaults(func=calibrate)
    p = sub.add_parser('run', help='run the arms, then grade every document')
    p.add_argument('--stage', required=True, help='screen, rescreen-<n> or gate; only gate is counted')
    p.add_argument('--arm', action='append', choices=ARMS)
    p.add_argument('--case', action='append')
    p.add_argument('--runs', type=int, default=1)
    p.add_argument('--model', default='claude-sonnet-5-5')
    p.add_argument('--effort', default='high', choices=('low', 'medium', 'high'))
    p.add_argument('--task-max-usd', type=positive_cost, default=1.25)
    p.add_argument('--calibration')
    p.add_argument('--plugin')
    p.add_argument('--output-dir', required=True)
    p.add_argument('--no-judges', action='store_true')
    p.add_argument('--jobs', type=int, default=3)
    paid(p)
    p.set_defaults(func=run)
    p = sub.add_parser('grade', help='regrade a result dir: script graders, and judges with --judges (paid)')
    p.add_argument('result_dir')
    p.add_argument('--judges', action='store_true')
    paid(p)
    p.set_defaults(func=regrade)
    p = sub.add_parser('summarize', help='check a result dir and print the per-arm table and bars')
    p.add_argument('result_dir')
    p.set_defaults(func=lambda a: (print(markdown(summarize(a.result_dir))), 0)[1])
    args = parser.parse_args(argv)
    if args.command == 'run' and not (args.ledger and args.max_cost_usd):
        parser.error('run is paid: pass --ledger and --max-cost-usd')
    if getattr(args, 'judges', False) and not (args.ledger and args.max_cost_usd):
        parser.error('judges are paid: pass --ledger and --max-cost-usd')
    try:
        return args.func(args)
    except Failure as error:
        print(f'sotsog-eval: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
